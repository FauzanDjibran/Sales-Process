model AccFiscalYear {
  id         Int          @id @default(autoincrement())
  year_code  String       @unique
  year_label String
  year_name  String
  start_date DateTime     @db.Date
  end_date   DateTime     @db.Date
  note       String?
  status     FiscalStatus @default(Draft)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  periods  AccFiscalPeriod[]
  closings AccFiscalClosing[]

  /// The snapshot this year opens with, and the snapshots this year's own
  /// close produced for the year after it. Two relations to one table, so
  /// each is named — see `AccOpeningBalance`.
  opening_balances         AccOpeningBalance[] @relation("OpeningBalanceYear")
  sourced_opening_balances AccOpeningBalance[] @relation("OpeningBalanceSource")

  @@map("acc_fiscal_year")
}

model AccFiscalPeriod {
  id             Int          @id @default(autoincrement())
  fiscal_year_id Int
  sequence_no    Int
  period_code    String       @unique
  period_label   String
  period_name    String
  start_date     DateTime     @db.Date
  end_date       DateTime     @db.Date
  note           String?
  status         FiscalStatus @default(Draft)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  fiscal_year AccFiscalYear @relation(fields: [fiscal_year_id], references: [id])

  @@index([fiscal_year_id])
  @@map("acc_fiscal_period")
}

/// The closing state of one fiscal year, and what its close produced.
///
/// An explicit record rather than a status inferred from the existence of an
/// Opening Balance document. Inferring a fact from a row in another table is
/// the same habit `AccountSection` exists to stop: it works until somebody
/// writes that row for a second reason, and then nothing fails.
///
/// `AccFiscalYear.status` follows it: the year reads Closed once it is closed.
model AccFiscalClosing {
  id             Int                 @id @default(autoincrement())
  fiscal_year_id Int
  status         FiscalClosingStatus @default(Open)

  closed_at DateTime? @db.Timestamptz(6)
  /// Plain Int with no FK, exactly like `created_by` elsewhere — the DBML
  /// declares authorship that way throughout.
  closed_by Int?

  /// The `CLS-` journal this close produced, and the `OPB-` snapshot it wrote
  /// for the following year. Both are other modules' documents, so they are
  /// held as ids rather than as relations (CLAUDE.md §3): a relation would put
  /// a back-reference on `acc_journal`, which is a book and is meant to be
  /// liftable. Null until a close actually happens — nothing writes either yet.
  closing_journal_id Int?
  opening_balance_id Int?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  fiscal_year AccFiscalYear @relation(fields: [fiscal_year_id], references: [id])

  @@unique([fiscal_year_id])
  @@map("acc_fiscal_closing")
}

/// The balances at the start of one fiscal year — a snapshot, not a
/// running store.
///
/// It exists so that a report does not have to scan from the first historical
/// transaction to work out where an account stood, and so that a closed year
/// hands the next one its position in a form somebody can read. It is
/// **immutable**: written once, by a close or by a developer injecting go-live
/// figures, and never edited afterwards. There is no create form and no edit
/// path in the application.
///
/// Base currency only, deliberately: the journal, the General Ledger and the
/// Trial Balance are all base-currency statements, and a snapshot of them is
/// the same measure. That is why there is no `currency_id` here.
///
/// `source_fiscal_year_id` is what tells a generated snapshot from an injected
/// one. A close writes the year it closed; a developer seeding go-live
/// balances leaves it null, because nothing produced them.
model AccOpeningBalance {
  id           Int      @id @default(autoincrement())
  opening_no   String   @unique
  /// The day the figures speak for — the first day of the year being opened.
  posting_date DateTime @db.Date

  /// The year this snapshot opens.
  fiscal_year_id        Int
  /// The year whose close produced it, or null for injected go-live balances.
  source_fiscal_year_id Int?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  fiscal_year        AccFiscalYear  @relation("OpeningBalanceYear", fields: [fiscal_year_id], references: [id])
  source_fiscal_year AccFiscalYear? @relation("OpeningBalanceSource", fields: [source_fiscal_year_id], references: [id])

  lines AccOpeningBalanceLine[]

  /// One snapshot per year. A second would be a second answer to "where did
  /// the company stand on 1 January", and the document is
  /// immutable, so there is no legitimate way to reach two.
  @@unique([fiscal_year_id])
  @@map("acc_opening_balance")
}

/// One balance, at the grain the journal itself keeps: `(account, partner?)`.
///
/// A Hutang account owed to three branches produces three lines; an account
/// naming no Partner produces one line with `partner_id = null`. There is
/// deliberately **no** parent row holding the account's total — that figure is
/// the sum of its children, and an immutable snapshot has no rebuild function
/// to prove a stored duplicate still agrees with what it duplicates.
///
/// The grain is derived from the posted journal lines as they actually are,
/// never from `acc_account.require_partner`: reading the flag would drop a
/// partner-bearing balance sitting on an unflagged account, and would invent a
/// null-partner line for an account that has none.
///
/// Exactly one of `debit_amount` / `kredit_amount` carries the value, and the
/// document's two sides sum equal — after the P&L has been closed out, what
/// remains is a balance sheet.
model AccOpeningBalanceLine {
  id          Int @id @default(autoincrement())
  opening_id  Int
  sequence_no Int

  account_id Int
  partner_id Int?

  /// Base currency, like every figure in the journal this is a snapshot of.
  debit_amount  Decimal @default(0) @db.Decimal(18, 2)
  kredit_amount Decimal @default(0) @db.Decimal(18, 2)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  opening AccOpeningBalance @relation(fields: [opening_id], references: [id])
  account AccAccount        @relation(fields: [account_id], references: [id])
  partner MPartner?         @relation(fields: [partner_id], references: [id])

  /// One line per pair. The index is created `NULLS NOT DISTINCT` in the
  /// migration's own SQL — Postgres otherwise treats two null-partner rows for
  /// one account as distinct, which is precisely the duplicate this is for.
  /// Prisma cannot express that, so the migration says it and this says why.
  @@unique([opening_id, account_id, partner_id])
  @@index([opening_id])
  @@map("acc_opening_balance_line")
}

// ---------------------------------------------------------------- audit

/// One trail for every table. Referenced loosely by entity key and row id
/// rather than by FK, since it spans every table.
/// A journal produced by a business posting is `Posted` the moment it exists —
/// it is the record of something that has already happened. A **manual**
/// journal is typed by a person, so it is saved `Draft` first and reaches
/// `Posted` through the same posting engine; `Cancelled` retires a draft that
/// should not exist, since nothing in this application is deleted.
///
/// Only a `Posted` journal is accounting: the General Ledger, the Trial Balance
/// and every balance reader filter on it. See CLAUDE.md §12.
enum JournalStatus {
  Draft
  Posted
  Cancelled
}

/// The accounting journal. A `Posted` journal is append-only and immutable:
/// once posted, a journal and its lines are never updated and never deleted. A
/// correction is a new journal, exactly as a corrected business transaction is
/// a new document.
///
/// A manual journal is editable while it is still `Draft`, and a draft is not
/// accounting — it moves nothing and no report can see it.
///
/// Only the General Ledger derives from these lines. The operational books —
/// the Cash Bank Book and the subject ledgers — are independent historical
/// stores written alongside the journal, never from it (§2.5).
model AccJournal {
  id                 Int           @id @default(autoincrement())
  journal_no         String        @unique
  /// The day the journal belongs to in the books — its document's date, which
  /// may be earlier than today (a backdated document) and never later. A
  /// manual draft carries the date it is meant for; every reader filters
  /// `status: "Posted"`, so a draft's date reaches no report. When the journal
  /// was actually written is `created_at`. Null only on a draft saved before
  /// drafts carried a date.
  posting_date       DateTime?     @db.Date
  /// What produced this journal, for traceability back to the document.
  source_doc_type_id Int?
  source_doc_id      Int?
  description        String
  status             JournalStatus @default(Posted)
  /// Typed by a person rather than produced by a document's posting. It is the
  /// only kind of journal that is ever a draft, the only one that is editable,
  /// and the only one whose accounts are narrowed by the control-account rule.
  is_manual          Boolean       @default(false)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  source_doc_type SysDocType?      @relation(fields: [source_doc_type_id], references: [id])
  lines           AccJournalLine[]
  cash_bank_txs   FinCashBankTx[]

  @@index([posting_date])
  @@index([source_doc_type_id, source_doc_id])
  @@map("acc_journal")
}

/// One accounting entry. Exactly one of `debit_amount` / `kredit_amount`
/// carries the value and the other is zero; the two sides of a journal must
/// sum equal, which `postJournal` refuses to write without.
model AccJournalLine {
  id          Int @id @default(autoincrement())
  journal_id  Int
  sequence_no Int

  account_id Int
  partner_id Int?

  /// The line's own currency, which need not be the base one — and need not
  /// match the other lines of the same journal. A foreign document paid from a
  /// base-currency resource produces one journal holding both.
  currency_id   Int
  /// What `trx_amount` was worth: this line's currency to the base currency.
  /// `1` means the money is already base currency, and nothing else.
  exchange_rate Decimal @default(1) @db.Decimal(18, 6)

  /// **Base currency.** This is what the journal balances in, what the General
  /// Ledger reports, and what the Trial Balance totals — concept doc §11.2 and
  /// §16. Exactly one side carries value.
  debit_amount  Decimal @default(0) @db.Decimal(18, 2)
  kredit_amount Decimal @default(0) @db.Decimal(18, 2)
  /// The transaction-currency value of the entry, whichever side it fell on.
  /// Carried so a rupiah figure can be read back to the three hundred dollars
  /// that produced it; nothing is ever totalled in it.
  trx_amount    Decimal @db.Decimal(18, 2)

  description String

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  journal  AccJournal  @relation(fields: [journal_id], references: [id])
  account  AccAccount  @relation(fields: [account_id], references: [id])
  partner  MPartner?   @relation(fields: [partner_id], references: [id])
  currency RefCurrency @relation(fields: [currency_id], references: [id])

  @@index([journal_id])
  @@index([account_id])
  @@map("acc_journal_line")
}

/// Every create, update and lifecycle transition in the application appends one
/// row here, and nothing ever updates or deletes one.
///
/// `action` is the coarse verb and `event` is the specific thing that
/// happened. The verb alone cannot answer what a history is opened for:
/// submit, approve, reject, post and confirm are all writes, so all of them
/// read as UPDATE. `event` carries the transition key the owning module's
/// workflow table already declares — "submit", "approve", "post" — and the
/// Indonesian label is read back from that table rather than stored here, so a
/// new lifecycle step is a row in a workflow table and not a migration.
///
/// It is nullable because rows written before the column existed genuinely do
/// not know which transition they were, and "Diubah" is the true answer for
/// them. See `lib/siba/audit-events.ts`.
model AuditLog {
  id         Int         @id @default(autoincrement())
  entity_key String
  row_id     Int
  action     AuditAction
  event      String?
  at         DateTime    @default(now()) @db.Timestamptz(6)
  by         Int

  @@index([entity_key, row_id])
  @@map("audit_log")
}

// ================================================================ sales
//
// Sales documents (Claude-ERP.md §3.2). Rupiah only for now (P13), so no
// currency column: every amount here is IDR.

/// A Customer Order (P49, P78; called the Sales Order until P78) — the
/// commercial agreement: what the customer ordered, at what price, with what
/// tax. Advances and invoices are drawn from it; the Sales Orders that release
/// its quantity to PPIC are its children. Posts nothing: no journal, no book, no tax
/// document. Its totals are stored as the tax module computed them at the last
/// save, so a list can show them and a confirmed order keeps the figures it was
/// confirmed with.
model SalCustomerOrder {
  id         Int                 @id @default(autoincrement())
  /// `CO/YYYY/MM/NNNN`, in the series of the order's own month (P78).
  order_no   String              @unique
  order_date DateTime            @db.Date
  status     CustomerOrderStatus @default(Draft)

  customer_id               Int
  /// One of the customer's addresses, by id (P53).
  address_id                Int
  term_id                   Int
  /// Whether the order carries PPN at all, decided once for the order (P52).
  is_taxable                Boolean   @default(true)
  price_mode                PriceMode
  /// The PPN rate and DPP Nilai Lain factor the order was computed with,
  /// snapshotted from the System Default at each save while Draft and frozen
  /// at Ajukan (P60, P63). Null when the order is not Kena PPN.
  ppn_rate                  Decimal?  @db.Decimal(9, 4)
  ppn_dpp_other_numerator   Int?
  ppn_dpp_other_denominator Int?

  po_no       String?
  po_date     DateTime? @db.Date
  /// Free text (P43, P52).
  salesperson String?
  note        String?

  // ---- totals, from `lib/erp/sales-tax.ts`, whole rupiah.
  gross_amount     Decimal @default(0) @db.Decimal(18, 2)
  discount_amount  Decimal @default(0) @db.Decimal(18, 2)
  dpp_amount       Decimal @default(0) @db.Decimal(18, 2)
  /// DPP Nilai Lain, the sum of the lines' (P60).
  dpp_other_amount Decimal @default(0) @db.Decimal(18, 2)
  ppn_amount       Decimal @default(0) @db.Decimal(18, 2)
  total_amount     Decimal @default(0) @db.Decimal(18, 2)

  /// Why the order was cancelled, rejected or closed by hand — the one final
  /// step it took (P63). Null for an order closed because it was fulfilled.
  status_reason  String?
  /// The order this one was copied from with Salin, if any.
  copied_from_id Int?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  customer        MPartner               @relation(fields: [customer_id], references: [id])
  address         MPartnerAddress        @relation(fields: [address_id], references: [id])
  term            RefPaymentTerm         @relation(fields: [term_id], references: [id])
  copied_from     SalCustomerOrder?      @relation("CustomerOrderCopy", fields: [copied_from_id], references: [id])
  copies          SalCustomerOrder[]     @relation("CustomerOrderCopy")
  lines           SalCustomerOrderLine[]
  /// The Sales Orders that release this order's quantity to PPIC (P79).
  sales_orders    SalOrder[]
  /// The Delivery Orders that send this order's goods, and the notes they leave on.
  delivery_orders SalDeliveryOrder[]

  @@index([customer_id])
  @@index([status, order_date])
  @@map("sal_customer_order")
}

/// One line of a Customer Order: a Barang, in one of its units, at a typed price.
model SalCustomerOrderLine {
  id       Int @id @default(autoincrement())
  order_id Int
  line_no  Int

  item_id    Int
  uom_id     Int
  /// Base units in one `uom_id`, copied from the item at save — 1 for the
  /// base unit — so a later change to the item's conversions does not change
  /// what this order asked for.
  uom_factor Decimal @db.Decimal(18, 4)
  qty        Decimal @db.Decimal(18, 4)
  /// Per `uom_id`, typed in the order's price mode.
  price      Decimal @db.Decimal(18, 6)

  discount_type    DiscountType?
  /// A percent (`Percent`) or an amount (`Amount`), as typed.
  discount_value   Decimal?      @db.Decimal(18, 4)
  discount_amount  Decimal       @default(0) @db.Decimal(18, 2)
  /// qty × price − discount, whole rupiah.
  amount           Decimal       @db.Decimal(18, 2)
  dpp_amount       Decimal       @db.Decimal(18, 2)
  /// DPP Nilai Lain of this line; PPN is computed per line from it (P60).
  dpp_other_amount Decimal       @default(0) @db.Decimal(18, 2)
  ppn_amount       Decimal       @db.Decimal(18, 2)

  /// The PPh the customer is expected to withhold on this line, or null (P52).
  withholding_tax_id Int?
  /// The rate at save, so an estimate does not move when the master does.
  withholding_rate   Decimal? @db.Decimal(9, 4)

  /// What posted Delivery Notes sent of this line, written by the Sales
  /// Order module as each posts (U21): the order closes itself once every line
  /// is fully delivered.
  delivered_qty Decimal @default(0) @db.Decimal(18, 4)

  note String?

  order             SalCustomerOrder   @relation(fields: [order_id], references: [id])
  item              MItem              @relation(fields: [item_id], references: [id])
  uom               RefUom             @relation(fields: [uom_id], references: [id])
  withholding_tax   RefWithholdingTax? @relation(fields: [withholding_tax_id], references: [id])
  sales_order_lines SalOrderLine[]

  @@unique([order_id, line_no])
  @@index([item_id])
  @@map("sal_customer_order_line")
}

// ------------------------------------------------------- pengajuan perizinan
//
// The Perizinan flow's agreement (P137, Perizinan-Concept.md §5–§6): the
// internal list of permits arranged for a makloon customer's product, each at
// its estimate and, once realised on the same document, at its real price.
// Posts nothing. The customer's documents (Uang Muka and Invoice Perizinan)
// carry one description line; the permits stay here.

enum PermitRequestStatus {
  Draft
  Submitted
  /// Disetujui: the estimate is locked and may be billed an advance.
  Open
  /// Terealisasi: the real prices are locked; it may be invoiced and its cost paid.
  Realized
  /// Selesai: its Invoice Perizinan is posted.
  Done
  Cancelled
  Rejected
}

model SalPermitRequest {
  id           Int                 @id @default(autoincrement())
  /// `PRZ/YYYY/MM/NNNN`, `PRZ-NP/…` without PPN (P109).
  request_no   String              @unique
  request_date DateTime            @db.Date
  status       PermitRequestStatus @default(Draft)

  customer_id               Int
  address_id                Int
  term_id                   Int
  is_taxable                Boolean   @default(true)
  price_mode                PriceMode
  /// The snapshot (P60): at each save while Draft, frozen at Ajukan.
  ppn_rate                  Decimal?  @db.Decimal(9, 4)
  ppn_dpp_other_numerator   Int?
  ppn_dpp_other_denominator Int?
  /// One Jenis PPh for the whole Pengajuan (QZ7), of usage Sales; none = not withheld.
  withholding_tax_id        Int?
  withholding_rate          Decimal?  @db.Decimal(9, 4)

  po_no        String?
  po_date      DateTime? @db.Date
  salesperson  String?
  /// The makloon product the permits are for, printed on the customer's documents.
  product_name String
  note         String?

  // ---- the estimate, PPN once on the total (Z5), whole rupiah.
  /// Σ the lines' estimates, in the price mode.
  estimate_amount    Decimal @default(0) @db.Decimal(18, 2)
  estimate_dpp       Decimal @default(0) @db.Decimal(18, 2)
  estimate_dpp_other Decimal @default(0) @db.Decimal(18, 2)
  estimate_ppn       Decimal @default(0) @db.Decimal(18, 2)
  estimate_total     Decimal @default(0) @db.Decimal(18, 2)

  // ---- the realisation (Z7), on the same document.
  /// `RLZ/YYYY/MM/NNNN`, given at Realisasikan.
  realization_no     String?   @unique
  realization_date   DateTime? @db.Date
  realization_note   String?
  realized_amount    Decimal   @default(0) @db.Decimal(18, 2)
  realized_dpp       Decimal   @default(0) @db.Decimal(18, 2)
  realized_dpp_other Decimal   @default(0) @db.Decimal(18, 2)
  realized_ppn       Decimal   @default(0) @db.Decimal(18, 2)
  realized_total     Decimal   @default(0) @db.Decimal(18, 2)
  /// What posted Biaya Perizinan payments paid of the realised DPP (Z14, P132).
  cost_paid_amount   Decimal   @default(0) @db.Decimal(18, 2)

  status_reason String?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  customer        MPartner               @relation(fields: [customer_id], references: [id])
  address         MPartnerAddress        @relation(fields: [address_id], references: [id])
  term            RefPaymentTerm         @relation(fields: [term_id], references: [id])
  withholding_tax RefWithholdingTax?     @relation(fields: [withholding_tax_id], references: [id])
  lines           SalPermitRequestLine[]

  @@index([customer_id])
  @@index([status, request_date])
  @@map("sal_permit_request")
}

/// One permit on a Pengajuan, each Jenis Perizinan once.
model SalPermitRequestLine {
  id             Int      @id @default(autoincrement())
  request_id     Int
  line_no        Int
  permit_type_id Int
  description    String
  /// In the Pengajuan's price mode; 0 only on a permit added at realisation.
  estimate_price Decimal  @db.Decimal(18, 2)
  /// Null until the realisation is entered; 0 = not done.
  realized_price Decimal? @db.Decimal(18, 2)
  /// Added at realisation, not estimated.
  is_added       Boolean  @default(false)

  request     SalPermitRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)
  permit_type RefPermitType    @relation(fields: [permit_type_id], references: [id])

  @@unique([request_id, line_no])
  @@unique([request_id, permit_type_id])
  @@map("sal_permit_request_line")
}

/// A Sales Order (P79): one dated slice of an Open Customer Order's quantity,
/// released to PPIC — e.g. 10.000 PCS ordered, delivered as five Sales Orders
/// of 2.000, one a month. It carries quantity and a delivery date only: the
/// price, the tax and every financial document stay with the Customer Order.
/// It posts nothing at any step, and it is not an AR item.
model SalOrder {
  id            Int              @id @default(autoincrement())
  /// `SO/YYYY/MM/NNNN`, in the series of the order's own month.
  order_no      String           @unique
  order_date    DateTime         @db.Date
  /// When the goods are to be delivered — what PPIC plans to.
  delivery_date DateTime         @db.Date
  status        SalesOrderStatus @default(Draft)

  /// The one Customer Order it is drawn from, chosen once and locked.
  customer_order_id Int
  /// The order's customer, kept here so a list reads without a join.
  customer_id       Int
  /// Where this delivery goes: any of the customer's addresses, starting on
  /// the Customer Order's.
  address_id        Int
  note              String?

  /// Why it was cancelled, rejected or closed by hand.
  status_reason String?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  customer_order SalCustomerOrder @relation(fields: [customer_order_id], references: [id])
  customer       MPartner         @relation(fields: [customer_id], references: [id])
  address        MPartnerAddress  @relation(fields: [address_id], references: [id])
  lines          SalOrderLine[]

  @@index([customer_order_id])
  @@index([status, delivery_date])
  @@map("sal_order")
}

/// One line of a Sales Order: a quantity of one Customer Order line, in that
/// line's unit. The item and the unit are read from the Customer Order line,
/// which is frozen once the order is submitted.
model SalOrderLine {
  id                     Int     @id @default(autoincrement())
  order_id               Int
  line_no                Int
  customer_order_line_id Int
  qty                    Decimal @db.Decimal(18, 4)
  /// What posted Delivery Notes sent of this line, written through the Sales
  /// Order module when a note posts (U14). A closed Sales Order holds only this
  /// much of its Customer Order line.
  delivered_qty          Decimal @default(0) @db.Decimal(18, 4)
  note                   String?

  order                SalOrder               @relation(fields: [order_id], references: [id])
  customer_order_line  SalCustomerOrderLine   @relation(fields: [customer_order_line_id], references: [id])
  delivery_order_lines SalDeliveryOrderLine[]

  @@unique([order_id, line_no])
  @@unique([order_id, customer_order_line_id])
  @@index([customer_order_line_id])
  @@map("sal_order_line")
}

enum DeliveryOrderStatus {
  Draft
  Issued
  Closed
  Cancelled
}

/// A Delivery Order (P93): the instruction to one warehouse to send goods of
/// one Customer Order to one address on one date. Its header names the
/// Customer Order; its lines are lines of that order's **Open** Sales Orders,
/// so one Delivery Order may ship from several Sales Orders. Quantity only —
/// no price and no tax — and it posts nothing: the Delivery Note, which the
/// goods actually leave on, will post HPP / Persediaan (P18).
model SalDeliveryOrder {
  id            Int                 @id @default(autoincrement())
  /// `DO/YYYY/MM/NNNN`, in the series of the order's own month.
  do_no         String              @unique
  do_date       DateTime            @db.Date
  /// When the goods are to leave the warehouse.
  delivery_date DateTime            @db.Date
  status        DeliveryOrderStatus @default(Draft)

  /// The one Customer Order it ships from, chosen once and locked.
  customer_order_id Int
  /// The order's customer, kept here so a list reads without a join.
  customer_id       Int
  /// The warehouse the goods leave from — one per Delivery Order.
  warehouse_id      Int
  /// Where the goods go: any of the customer's addresses.
  address_id        Int
  note              String?

  /// Why it was cancelled or closed by hand.
  status_reason String?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  customer_order SalCustomerOrder       @relation(fields: [customer_order_id], references: [id])
  customer       MPartner               @relation(fields: [customer_id], references: [id])
  warehouse      RefWarehouse           @relation(fields: [warehouse_id], references: [id])
  address        MPartnerAddress        @relation(fields: [address_id], references: [id])
  lines          SalDeliveryOrderLine[]

  @@index([customer_order_id])
  @@index([status, delivery_date])
  @@map("sal_delivery_order")
}

/// One line of a Delivery Order: a quantity of one Sales Order line, in that
/// line's unit. The Delivery Orders on a Sales Order line never hold more than
/// the line.
model SalDeliveryOrderLine {
  id                  Int     @id @default(autoincrement())
  delivery_order_id   Int
  line_no             Int
  sales_order_line_id Int
  qty                 Decimal @db.Decimal(18, 4)
  /// What posted Delivery Notes sent of this line, written through the
  /// Delivery Order module when a note posts (U14). A closed Delivery Order
  /// holds only this much of its Sales Order line.
  delivered_qty       Decimal @default(0) @db.Decimal(18, 4)
  note                String?

  delivery_order   SalDeliveryOrder @relation(fields: [delivery_order_id], references: [id])
  sales_order_line SalOrderLine     @relation(fields: [sales_order_line_id], references: [id])

  @@unique([delivery_order_id, line_no])
  @@unique([delivery_order_id, sales_order_line_id])
  @@index([sales_order_line_id])
  @@map("sal_delivery_order_line")
}

enum DeliveryNoteStatus {
  Draft
  Posted
  Cancelled
}

/// A Delivery Note (P106; C28, P94, P95): the document goods leave the
/// company's warehouse on, to a partner. **Standalone** — it belongs to no
/// business module: its `purpose` (a catalogue in code,
/// `lib/erp/delivery-note-purposes.ts`) says what its source is, how it posts
/// and what it writes back; its source is named by the weak pair. Quantity and
/// stock cost only — never a selling price or tax. Numbered `SJ/YYYY/MM/NNNN`.
/// Purpose `sales_delivery`: from an issued Delivery Order; Posting issues the
/// goods through the inventory module and writes Dr HPP / Cr Persediaan.
model LogDeliveryNote {
  id      Int                @id @default(autoincrement())
  dn_no   String             @unique
  /// The day the goods leave — the journal's date and, for a sale, the tax point.
  dn_date DateTime           @db.Date
  status  DeliveryNoteStatus @default(Draft)

  /// The purpose's key, e.g. `sales_delivery`.
  purpose            String
  /// The source document, weak (§3.1): for `sales_delivery` a Delivery Order.
  source_doc_type_id Int
  source_doc_id      Int
  source_no          String
  /// Copied from the source, for lists and printing.
  partner_id         Int
  warehouse_id       Int
  address_id         Int

  vehicle_no  String?
  driver_name String?
  note        String?

  /// Σ of the lines' cost, set at Posting.
  cost_amount   Decimal @default(0) @db.Decimal(18, 2)
  journal_id    Int?
  cancel_reason String?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  source_doc_type SysDocType            @relation("DeliveryNoteSource", fields: [source_doc_type_id], references: [id])
  partner         MPartner              @relation(fields: [partner_id], references: [id])
  warehouse       RefWarehouse          @relation(fields: [warehouse_id], references: [id])
  address         MPartnerAddress       @relation(fields: [address_id], references: [id])
  lines           LogDeliveryNoteLine[]

  @@index([source_doc_type_id, source_doc_id])
  @@index([purpose, status])
  @@index([status, dn_date])
  @@map("log_delivery_note")
}

/// One line of a Delivery Note: a quantity of one source line, weak. It
/// carries its own item, unit and factor, because a line of another purpose has
/// another source. Its cost is fixed at Posting from what the inventory module
/// returned.
model LogDeliveryNoteLine {
  id                 Int     @id @default(autoincrement())
  delivery_note_id   Int
  line_no            Int
  /// The source line, weak: for `sales_delivery` a Delivery Order line.
  source_doc_line_id Int
  item_id            Int
  uom_id             Int
  /// Base units in one `uom_id`, copied from the source at save.
  uom_factor         Decimal @default(1) @db.Decimal(18, 4)
  qty                Decimal @db.Decimal(18, 4)
  /// qty × uom_factor.
  base_qty           Decimal @default(0) @db.Decimal(18, 4)
  unit_cost          Decimal @default(0) @db.Decimal(18, 6)
  cost_amount        Decimal @default(0) @db.Decimal(18, 2)
  note               String?

  delivery_note LogDeliveryNote      @relation(fields: [delivery_note_id], references: [id])
  item          MItem                @relation(fields: [item_id], references: [id])
  uom           RefUom               @relation(fields: [uom_id], references: [id])
  /// For an item with Kelola Stok: which lots the line's quantity is taken
  /// from (U15). Their quantities add up to the line's at Posting.
  lots          LogDeliveryNoteLot[]

  @@unique([delivery_note_id, line_no])
  @@unique([delivery_note_id, source_doc_line_id])
  @@index([source_doc_line_id])
  @@index([item_id])
  @@map("log_delivery_note_line")
}

/// One lot a Delivery Note line takes goods from (U15) — the stock picking.
/// Written with the note while it is a Draft; at Posting each pick is issued
/// on its own and stores what it cost. The lot is the inventory's, named by id
/// without a foreign key (the inventory behind it is a stand-in today), with
/// its number and expiry copied as printed on the note.
model LogDeliveryNoteLot {
  id                    Int       @id @default(autoincrement())
  delivery_note_line_id Int
  pick_no               Int
  lot_id                Int
  /// The location it is taken from, in a warehouse with Gunakan Lokasi.
  location_id           Int?
  lot_no                String
  expiry_date           DateTime? @db.Date
  /// In the line's unit.
  qty                   Decimal   @db.Decimal(18, 4)
  base_qty              Decimal   @default(0) @db.Decimal(18, 4)
  unit_cost             Decimal   @default(0) @db.Decimal(18, 6)
  cost_amount           Decimal   @default(0) @db.Decimal(18, 2)

  line LogDeliveryNoteLine @relation(fields: [delivery_note_line_id], references: [id])

  @@unique([delivery_note_line_id, pick_no])
  /// A pick is a lot in a location: unique on (line, lot, location) NULLS NOT
  /// DISTINCT, the NULLS NOT DISTINCT added in the migration by hand.
  @@unique([delivery_note_line_id, lot_id, location_id], map: "log_delivery_note_lot_pick_key")
  @@index([lot_id])
  @@map("log_delivery_note_lot")
}

enum InvoiceStatus {
  Draft
  Posted
  Cancelled
}

/// The Faktur Penjualan (`Sales-Process-Concept.md` §9, U16–U22): the bill
/// for goods already sent. One Customer Order; its lines are whole lines of
/// that order's posted Delivery Notes. Posting writes Piutang, revenue and
/// PPN, uses the order's Uang Muka the user picked, and creates the Invoice
/// AR item.
model FinArInvoice {
  id           Int           @id @default(autoincrement())
  invoice_no   String        @unique
  /// Typed; the journal's date. Not before `tax_date`.
  invoice_date DateTime      @db.Date
  /// The latest Tanggal Kirim of the notes billed — the faktur pajak's date (U19).
  tax_date     DateTime      @db.Date
  /// `tax_date` + the order's Termin days (U19).
  due_date     DateTime      @db.Date
  status       InvoiceStatus @default(Draft)

  customer_order_id Int
  customer_id       Int
  /// The billing address: any of the customer's.
  address_id        Int
  /// Where the customer is asked to pay, printed on the bill.
  cash_bank_id      Int

  /// The order's, copied (U18, U20).
  price_mode                PriceMode
  is_taxable                Boolean
  ppn_rate                  Decimal?  @db.Decimal(9, 4)
  ppn_dpp_other_numerator   Int?
  ppn_dpp_other_denominator Int?

  // ---- totals, from `lib/erp/sales-tax.ts` (`computeInvoice`), whole rupiah.
  /// Σ of the lines' gross and discount (P111); amount = gross − discount.
  gross_amount       Decimal @default(0) @db.Decimal(18, 2)
  discount_amount    Decimal @default(0) @db.Decimal(18, 2)
  amount             Decimal @default(0) @db.Decimal(18, 2)
  /// DPP of the goods billed.
  dpp_amount         Decimal @default(0) @db.Decimal(18, 2)
  /// Uang Muka used, in DPP (U8).
  advance_dpp_amount Decimal @default(0) @db.Decimal(18, 2)
  /// The PPN of the Uang Muka used, deducted once from the full PPN (P113,
  /// settlement-ppn = full-less-advance); ppn_amount = Σ lines − this.
  advance_ppn_amount Decimal @default(0) @db.Decimal(18, 2)
  net_dpp_amount     Decimal @default(0) @db.Decimal(18, 2)
  dpp_other_amount   Decimal @default(0) @db.Decimal(18, 2)
  ppn_amount         Decimal @default(0) @db.Decimal(18, 2)
  /// Net Piutang: net DPP + PPN.
  total_amount       Decimal @default(0) @db.Decimal(18, 2)
  /// What posted receipts settled of it, cash + PPh (P133): a receipt's
  /// `before`, added to as it posts; total − paid = its Invoice item's balance.
  paid_amount        Decimal @default(0) @db.Decimal(18, 2)

  /// Coretax number of its faktur pajak, typed after upload (U10).
  tax_invoice_no String?
  journal_id     Int?
  /// The Invoice AR item it created; none when nothing is left to pay.
  ar_item_id     Int?
  note           String?
  cancel_reason  String?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  customer   MPartner                       @relation(fields: [customer_id], references: [id])
  address    MPartnerAddress                @relation(fields: [address_id], references: [id])
  cash_bank  MCashBank                      @relation(fields: [cash_bank_id], references: [id])
  lines      FinArInvoiceLine[]
  deductions FinArInvoiceAdvanceDeduction[]

  @@index([customer_order_id])
  @@index([status, invoice_date])
  @@map("fin_ar_invoice")
}

/// One Faktur line: one Delivery Note line, whole (U17), priced from its
/// Customer Order line. A Delivery Note line is billed by at most one live
/// Faktur, checked under the order's lock.
model FinArInvoiceLine {
  id                     Int           @id @default(autoincrement())
  invoice_id             Int
  line_no                Int
  delivery_note_line_id  Int
  customer_order_line_id Int
  /// The Delivery Note line's, in the order line's unit.
  qty                    Decimal       @db.Decimal(18, 4)
  /// The order line's unit price, unrounded (P111).
  price                  Decimal       @db.Decimal(18, 6)
  /// This line's gross and discount, its cumulative share of the order line's
  /// (P112, `tax_concept.md` §7.5); amount = gross − discount.
  gross_amount           Decimal       @default(0) @db.Decimal(18, 2)
  discount_type          DiscountType?
  discount_value         Decimal?      @db.Decimal(18, 4)
  discount_amount        Decimal       @default(0) @db.Decimal(18, 2)
  amount                 Decimal       @db.Decimal(18, 2)
  dpp_amount             Decimal       @db.Decimal(18, 2)
  /// Its share of the Uang Muka used.
  advance_dpp_amount     Decimal       @default(0) @db.Decimal(18, 2)
  net_dpp_amount         Decimal       @db.Decimal(18, 2)
  dpp_other_amount       Decimal       @default(0) @db.Decimal(18, 2)
  ppn_amount             Decimal       @default(0) @db.Decimal(18, 2)
  /// The order line's, carried for the PPh the receipt will expect.
  withholding_tax_id     Int?
  withholding_rate       Decimal?      @db.Decimal(9, 4)

  invoice         FinArInvoice       @relation(fields: [invoice_id], references: [id])
  withholding_tax RefWithholdingTax? @relation(fields: [withholding_tax_id], references: [id])

  @@unique([invoice_id, line_no])
  @@unique([invoice_id, delivery_note_line_id])
  @@index([delivery_note_line_id])
  @@index([customer_order_line_id])
  @@map("fin_ar_invoice_line")
}

/// An Uang Muka the Faktur uses (U8, U10): the AR item, by id — the AR items
/// are a book — and the DPP typed from it.
model FinArInvoiceAdvanceDeduction {
  id         Int     @id @default(autoincrement())
  invoice_id Int
  ar_item_id Int
  ar_item_no String
  dpp_used   Decimal @db.Decimal(18, 2)
  /// Its cumulative share of the item's PPN (tax_ppn), P113 / tax_concept §7.5.
  ppn_used   Decimal @default(0) @db.Decimal(18, 2)

  invoice FinArInvoice @relation(fields: [invoice_id], references: [id])

  @@unique([invoice_id, ar_item_id])
  @@index([ar_item_id])
  @@map("fin_ar_invoice_advance_deduction")
}

// ------------------------------------------------------------ inventory

/// Stock status — system data, seeded (P120): Tersedia, Karantina, Diblokir,
/// as SAP's unrestricted / quality inspection / blocked. A quantity is held in
/// one status; only Tersedia is received into and issued from today.
model SysStockStatus {
  id           Int     @id @default(autoincrement())
  status_code  String  @unique
  status_label String  @unique
  status_name  String
  /// Whether stock in this status may be issued to a customer.
  is_issuable  Boolean @default(false)
  sort_order   Int     @default(0)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  ledger   LogStockLedger[]
  balances LogStockBalance[]

  @@map("sys_stock_status")
}

/// A lot (P120): one tracking per item and number, made by the receipt that
/// first brings it in. Every item with Kelola Stok is held by lot; an item
/// without it never enters the stock books. Unique per item, not globally, so
/// two suppliers' "B001" may coexist; a later receipt of the same number adds
/// to the same lot. Named only by `lib/erp/inventory.ts`.
model LogStockTracking {
  id                 Int       @id @default(autoincrement())
  tracking_no        String
  /// The day it was first received.
  tracking_date      DateTime  @db.Date
  item_id            Int
  /// The document that first received it, weak (§3.1).
  source_doc_type_id Int
  source_doc_id      Int
  source_no          String
  /// Who supplied it, when the receipt names one.
  source_partner_id  Int?
  /// Required when the item has Memiliki Kadaluarsa.
  expiry_date        DateTime? @db.Date

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  item            MItem      @relation(fields: [item_id], references: [id])
  source_doc_type SysDocType @relation("StockTrackingSource", fields: [source_doc_type_id], references: [id])
  source_partner  MPartner?  @relation(fields: [source_partner_id], references: [id])

  ledger   LogStockLedger[]
  balances LogStockBalance[]

  @@unique([item_id, tracking_no])
  @@index([source_doc_type_id, source_doc_id])
  @@map("log_stock_tracking")
}

/// The stock ledger (P120): one row per quantity movement of one lot in one
/// warehouse and status. Append-only. `qty_balance` is that bucket's quantity
/// after the row, in posting order; `value_change` equals its twin row in the
/// valuation ledger. `unit_cost` describes the row (|value ÷ qty|) and is never
/// read back into a calculation (P114). Rows of one posting share `ledger_no`
/// (`MS/YYYY/MM/NNNN`, P110).
model LogStockLedger {
  id                 Int      @id @default(autoincrement())
  ledger_no          String
  line_no            Int
  posting_date       DateTime @db.Date
  source_doc_type_id Int
  source_doc_id      Int
  source_no          String
  warehouse_id       Int
  /// Required in a warehouse with Gunakan Lokasi, null otherwise.
  location_id        Int?
  tracking_id        Int
  item_id            Int
  /// The item's base unit.
  uom_id             Int
  stock_status_id    Int
  qty_change         Decimal  @db.Decimal(18, 6)
  qty_balance        Decimal  @db.Decimal(18, 6)
  unit_cost          Decimal  @db.Decimal(18, 6)
  /// Whole rupiah (P114).
  value_change       Decimal  @db.Decimal(18, 2)
  created_by         Int
  created_at         DateTime @default(now()) @db.Timestamptz(6)

  source_doc_type SysDocType            @relation("StockLedgerSource", fields: [source_doc_type_id], references: [id])
  warehouse       RefWarehouse          @relation(fields: [warehouse_id], references: [id])
  location        RefWarehouseLocation? @relation(fields: [location_id], references: [id], onDelete: Restrict)
  tracking        LogStockTracking      @relation(fields: [tracking_id], references: [id])
  item            MItem                 @relation(fields: [item_id], references: [id])
  uom             RefUom                @relation("StockLedgerUom", fields: [uom_id], references: [id])
  stock_status    SysStockStatus        @relation(fields: [stock_status_id], references: [id])

  @@unique([ledger_no, line_no])
  @@index([item_id, warehouse_id, posting_date])
  @@index([tracking_id])
  @@index([source_doc_type_id, source_doc_id])
  @@map("log_stock_ledger")
}

/// The quantity on hand per warehouse, lot and status — the stock ledger's
/// sum, kept in the same transaction as each row and locked while a posting
/// moves it. Never negative.
model LogStockBalance {
  id              Int      @id @default(autoincrement())
  warehouse_id    Int
  /// Required in a warehouse with Gunakan Lokasi, null otherwise.
  location_id     Int?
  tracking_id     Int
  item_id         Int
  uom_id          Int
  stock_status_id Int
  qty_balance     Decimal  @db.Decimal(18, 6)
  created_by      Int
  updated_by      Int?
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  warehouse    RefWarehouse          @relation(fields: [warehouse_id], references: [id])
  location     RefWarehouseLocation? @relation(fields: [location_id], references: [id], onDelete: Restrict)
  tracking     LogStockTracking      @relation(fields: [tracking_id], references: [id])
  item         MItem                 @relation(fields: [item_id], references: [id])
  uom          RefUom                @relation("StockBalanceUom", fields: [uom_id], references: [id])
  stock_status SysStockStatus        @relation(fields: [stock_status_id], references: [id])

  /// The bucket is unique on (warehouse_id, location_id, tracking_id,
  /// stock_status_id) NULLS NOT DISTINCT: Prisma declares the key, and the
  /// migration adds NULLS NOT DISTINCT by hand, which Prisma cannot express.
  @@unique([warehouse_id, location_id, tracking_id, stock_status_id], map: "log_stock_balance_bucket_key")
  @@index([item_id, warehouse_id])
  @@map("log_stock_balance")
}

/// The valuation ledger (P114, P120): one row per movement of an item's one
/// moving-average pool (company-wide: one company, one valuation area). Each
/// row stores its changes and the pool after them; Σ value_change = the pool's
/// V. `avg_unit_cost` is V ÷ Q cached for reading, never multiplied. Rows of
/// one posting share `ledger_no` (`MN/YYYY/MM/NNNN`, P110).
model LogStockValuationLedger {
  id                 Int      @id @default(autoincrement())
  ledger_no          String
  line_no            Int
  posting_date       DateTime @db.Date
  source_doc_type_id Int
  source_doc_id      Int
  source_no          String
  item_id            Int
  uom_id             Int
  qty_change         Decimal  @db.Decimal(18, 6)
  qty_balance        Decimal  @db.Decimal(18, 6)
  /// |value_change ÷ qty_change| — a description of the row.
  unit_cost          Decimal? @db.Decimal(18, 6)
  value_change       Decimal  @db.Decimal(18, 2)
  value_balance      Decimal  @db.Decimal(18, 2)
  avg_unit_cost      Decimal  @db.Decimal(18, 6)
  created_by         Int
  created_at         DateTime @default(now()) @db.Timestamptz(6)

  source_doc_type SysDocType @relation("StockValuationSource", fields: [source_doc_type_id], references: [id])
  item            MItem      @relation(fields: [item_id], references: [id])
  uom             RefUom     @relation("StockValuationLedgerUom", fields: [uom_id], references: [id])

  @@unique([ledger_no, line_no])
  @@index([item_id, posting_date])
  @@index([source_doc_type_id, source_doc_id])
  @@map("log_stock_valuation_ledger")
}

/// An item's moving-average pool (P114): Q and V are the truth, the average is
/// derived. Locked while a posting moves it.
model LogStockValuationBalance {
  id            Int      @id @default(autoincrement())
  item_id       Int      @unique
  uom_id        Int
  qty_balance   Decimal  @db.Decimal(18, 6)
  value_balance Decimal  @db.Decimal(18, 2)
  avg_unit_cost Decimal  @db.Decimal(18, 6)
  created_by    Int
  updated_by    Int?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  item MItem  @relation(fields: [item_id], references: [id])
  uom  RefUom @relation("StockValuationBalanceUom", fields: [uom_id], references: [id])

  @@map("log_stock_valuation_balance")
}

/// An AR advance bill — Uang Muka Penjualan (P54–P58). A bill, not a
/// transaction: it posts nothing at any step. It is the anchor the customer's
/// payment and, later, the invoice deduction name. Its money and its PPN are
/// recorded by Pembayaran on the day it arrives; how much of it is paid or used
/// is not stored here — that belongs to the open items (C22).
///
/// Always drawn from one Open Customer Order (P78), whose customer, address, price
/// mode and Kena PPN it follows. Its figures are stored as the tax module
/// computed them at the last save.
model FinArAdvance {
  id           Int           @id @default(autoincrement())
  /// `ARA/YYYY/MM/NNNN`, in the series of the bill's own month.
  advance_no   String        @unique
  advance_date DateTime      @db.Date
  due_date     DateTime      @db.Date
  status       AdvanceStatus @default(Draft)

  customer_order_id Int
  /// The order's customer, kept on the bill because the partner is what an
  /// advance is settled by (C22).
  customer_id       Int
  /// A Bank-type Cash & Bank in rupiah, printed on the bill as where to pay.
  cash_bank_id      Int
  /// The one line the bill prints.
  description       String
  note              String?

  /// Copied from the order, which is locked once confirmed.
  price_mode                PriceMode
  is_taxable                Boolean
  /// The bill's own snapshot of the PPN rate and DPP Nilai Lain factor, taken
  /// at each save while Draft and frozen at Terbitkan (P60). Null when the
  /// order is not Kena PPN.
  ppn_rate                  Decimal?  @db.Decimal(9, 4)
  ppn_dpp_other_numerator   Int?
  ppn_dpp_other_denominator Int?

  /// As typed: a percent of the order's value, or a flat value (P55).
  amount_type  AdvanceAmountType
  amount_value Decimal           @db.Decimal(18, 4)

  // ---- figures, from `lib/erp/sales-tax.ts`, whole rupiah.
  /// The value drawn, in the order's price mode — what the room is spent in.
  amount           Decimal @db.Decimal(18, 2)
  dpp_amount       Decimal @db.Decimal(18, 2)
  /// DPP Nilai Lain by the snapshotted factor; zero when not Kena PPN.
  dpp_other_amount Decimal @db.Decimal(18, 2)
  ppn_amount       Decimal @db.Decimal(18, 2)
  /// What the bill asks for: DPP + PPN.
  total_amount     Decimal @db.Decimal(18, 2)
  /// What posted receipts have settled of it, cash + PPh (P132). Each posting
  /// reads it as the payment's `before` and adds its line to it, so a receipt
  /// never reads another receipt.
  paid_amount      Decimal @default(0) @db.Decimal(18, 2)

  cancel_reason String?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  customer  MPartner  @relation(fields: [customer_id], references: [id])
  cash_bank MCashBank @relation(fields: [cash_bank_id], references: [id])

  @@index([customer_order_id])
  @@index([customer_id])
  @@index([status, advance_date])
  @@map("fin_ar_advance")
}

/// Uang Muka Perizinan (P137, Perizinan-Concept.md §7): the AR advance bill of
/// the Perizinan flow, drawn from one Pengajuan Perizinan. Header-only — its one
/// line is its Uraian. Posts nothing; mirrors `fin_ar_advance` (P58).
model FinArPermitAdvance {
  id           Int           @id @default(autoincrement())
  /// `UMP/YYYY/MM/NNNN` (`UMP-NP/…` without PPN), in its own month.
  advance_no   String        @unique
  advance_date DateTime      @db.Date
  due_date     DateTime      @db.Date
  status       AdvanceStatus @default(Draft)

  /// The Pengajuan Perizinan it is drawn from (P137, Z10) — another module's
  /// document, by id.
  permit_request_id Int
  /// The order's customer, kept on the bill because the partner is what an
  /// advance is settled by (C22).
  customer_id       Int
  /// A Bank-type Cash & Bank in rupiah, printed on the bill as where to pay.
  cash_bank_id      Int
  /// The one line the bill prints.
  description       String
  note              String?

  /// Copied from the order, which is locked once confirmed.
  price_mode                PriceMode
  is_taxable                Boolean
  /// The Pengajuan's one Jenis PPh and rate, copied (QZ7).
  withholding_tax_id        Int?
  withholding_rate          Decimal?  @db.Decimal(9, 4)
  /// The bill's own snapshot of the PPN rate and DPP Nilai Lain factor, taken
  /// at each save while Draft and frozen at Terbitkan (P60). Null when the
  /// order is not Kena PPN.
  ppn_rate                  Decimal?  @db.Decimal(9, 4)
  ppn_dpp_other_numerator   Int?
  ppn_dpp_other_denominator Int?

  /// As typed: a percent of the order's value, or a flat value (P55).
  amount_type  AdvanceAmountType
  amount_value Decimal           @db.Decimal(18, 4)

  // ---- figures, from `lib/erp/sales-tax.ts`, whole rupiah.
  /// The value drawn, in the order's price mode — what the room is spent in.
  amount           Decimal @db.Decimal(18, 2)
  dpp_amount       Decimal @db.Decimal(18, 2)
  /// DPP Nilai Lain by the snapshotted factor; zero when not Kena PPN.
  dpp_other_amount Decimal @db.Decimal(18, 2)
  ppn_amount       Decimal @db.Decimal(18, 2)
  /// What the bill asks for: DPP + PPN.
  total_amount     Decimal @db.Decimal(18, 2)
  /// What posted receipts have settled of it, cash + PPh (P132). Each posting
  /// reads it as the payment's `before` and adds its line to it, so a receipt
  /// never reads another receipt.
  paid_amount      Decimal @default(0) @db.Decimal(18, 2)

  cancel_reason String?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  customer  MPartner  @relation("PermitAdvanceCustomer", fields: [customer_id], references: [id])
  cash_bank MCashBank @relation("PermitAdvanceBank", fields: [cash_bank_id], references: [id])

  @@index([permit_request_id])
  @@index([customer_id])
  @@index([status, advance_date])
  @@map("fin_ar_permit_advance")
}

/// Invoice Perizinan (P137, Perizinan-Concept.md §9): bills one realised
/// Pengajuan Perizinan, header-only — its one line is its Uraian (Z1), its
/// figures the realisation's, computed by `computeInvoice` over that one line.
/// Deducts the Pengajuan's own Uang Muka items as the goods Invoice does (P113,
/// P117, P118). Posting writes the journal, the Invoice AR item and a one-line
/// faktur pajak, and marks the Pengajuan Selesai.
model FinArPermitInvoice {
  id           Int           @id @default(autoincrement())
  /// `INP/YYYY/MM/NNNN`, `INP-NP/…` without PPN.
  invoice_no   String        @unique
  invoice_date DateTime      @db.Date
  /// = invoice_date: a service's PPN is due when its completion is billed (Z15).
  tax_date     DateTime      @db.Date
  due_date     DateTime      @db.Date
  status       InvoiceStatus @default(Draft)

  /// The Pengajuan it bills — another module's document, by id.
  permit_request_id Int
  customer_id       Int
  address_id        Int
  cash_bank_id      Int
  /// The one line the customer sees (Z1).
  description       String

  price_mode                PriceMode
  is_taxable                Boolean
  ppn_rate                  Decimal?  @db.Decimal(9, 4)
  ppn_dpp_other_numerator   Int?
  ppn_dpp_other_denominator Int?
  withholding_tax_id        Int?
  withholding_rate          Decimal?  @db.Decimal(9, 4)

  // ---- figures, from `computeInvoice` over the one line, whole rupiah.
  /// The realised amount, in the price mode.
  amount             Decimal @default(0) @db.Decimal(18, 2)
  dpp_amount         Decimal @default(0) @db.Decimal(18, 2)
  advance_dpp_amount Decimal @default(0) @db.Decimal(18, 2)
  advance_ppn_amount Decimal @default(0) @db.Decimal(18, 2)
  net_dpp_amount     Decimal @default(0) @db.Decimal(18, 2)
  dpp_other_amount   Decimal @default(0) @db.Decimal(18, 2)
  /// PPN on the full DPP; ppn_amount = this − advance_ppn_amount (P113).
  full_ppn_amount    Decimal @default(0) @db.Decimal(18, 2)
  ppn_amount         Decimal @default(0) @db.Decimal(18, 2)
  /// Net Piutang: net DPP + PPN.
  total_amount       Decimal @default(0) @db.Decimal(18, 2)
  /// What posted receipts settled of it (P133).
  paid_amount        Decimal @default(0) @db.Decimal(18, 2)

  journal_id    Int?
  ar_item_id    Int?
  note          String?
  cancel_reason String?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  customer   MPartner                             @relation("PermitInvoiceCustomer", fields: [customer_id], references: [id])
  address    MPartnerAddress                      @relation("PermitInvoiceAddress", fields: [address_id], references: [id])
  cash_bank  MCashBank                            @relation("PermitInvoiceBank", fields: [cash_bank_id], references: [id])
  deductions FinArPermitInvoiceAdvanceDeduction[]

  @@index([permit_request_id])
  @@index([status, invoice_date])
  @@map("fin_ar_permit_invoice")
}

/// An Uang Muka item of the Pengajuan the Invoice Perizinan uses, and the DPP typed.
model FinArPermitInvoiceAdvanceDeduction {
  id         Int     @id @default(autoincrement())
  invoice_id Int
  ar_item_id Int
  ar_item_no String
  dpp_used   Decimal @db.Decimal(18, 2)
  /// Recalculated by the chain (P118).
  ppn_used   Decimal @default(0) @db.Decimal(18, 2)

  invoice FinArPermitInvoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@unique([invoice_id, ar_item_id])
  @@index([ar_item_id])
  @@map("fin_ar_permit_invoice_advance_deduction")
}

// ------------------------------------------------------ cash bank transaction
//
// Penerimaan and Pengeluaran Kas & Bank (Claude-ERP.md P66–P70): one document
// for every movement of money through a cash or bank resource, in one table
// for both directions. Its purpose — a key of the catalogue in
// `lib/erp/cash-bank-purposes.ts` — decides what it settles and how it posts.
// A Draft touches no book; posting writes the journal and the Cash Bank Book
// together.

enum CashBankTxStatus {
  Draft
  Posted
  Cancelled
}

model FinCashBankTx {
  id        Int              @id @default(autoincrement())
  /// `BKM/YYYY/MM/NNNN` for Penerimaan, `BKK/…` for Pengeluaran.
  tx_no     String           @unique
  direction FlowDirection
  /// A key of the purpose catalogue in code (P66), not a foreign key.
  purpose   String
  tx_date   DateTime         @db.Date
  status    CashBankTxStatus @default(Draft)

  partner_id   Int
  cash_bank_id Int
  /// The transaction number on the bank statement.
  bank_ref     String?
  note         String?

  /// What actually reached (or left) the resource — the Cash Bank Book amount.
  cash_amount    Decimal @db.Decimal(18, 2)
  /// The transfer fee the bank kept; the company absorbs it (P68).
  bank_charge    Decimal @default(0) @db.Decimal(18, 2)
  /// The lines' Dilunasi, summed.
  settled_amount Decimal @default(0) @db.Decimal(18, 2)
  /// The PPh the partner withheld, summed over lines and types.
  pph_amount     Decimal @default(0) @db.Decimal(18, 2)

  /// The journal posting wrote.
  journal_id    Int?
  cancel_reason String?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  partner   MPartner            @relation(fields: [partner_id], references: [id])
  cash_bank MCashBank           @relation(fields: [cash_bank_id], references: [id])
  journal   AccJournal?         @relation(fields: [journal_id], references: [id])
  lines     FinCashBankTxLine[]

  @@index([direction, status, tx_date])
  @@index([partner_id])
  @@map("fin_cash_bank_tx")
}

/// One document a transaction settles, named by the weak `(doc_type_id,
/// doc_id)` pair because it belongs to another module (§3.1). Each document
/// appears once per transaction.
model FinCashBankTxLine {
  id          Int @id @default(autoincrement())
  tx_id       Int
  line_no     Int
  doc_type_id Int
  doc_id      Int

  /// The part of the document this line clears: the cash received for it +
  /// the PPh withheld (P76; the bank charge is the header's alone).
  settled_amount Decimal @db.Decimal(18, 2)
  /// The Potong PPh switch (P60): off, the partner paid without withholding.
  withhold       Boolean @default(true)
  /// The split of `settled_amount` an advance's faktur pajak will carry.
  dpp_part       Decimal @default(0) @db.Decimal(18, 2)
  ppn_part       Decimal @default(0) @db.Decimal(18, 2)
  pph_amount     Decimal @default(0) @db.Decimal(18, 2)

  created_by Int
  created_at DateTime @default(now()) @db.Timestamptz(6)

  tx       FinCashBankTx          @relation(fields: [tx_id], references: [id], onDelete: Cascade)
  doc_type SysDocType             @relation(fields: [doc_type_id], references: [id])
  whts     FinCashBankTxLineWht[]

  @@unique([tx_id, doc_type_id, doc_id])
  @@index([doc_type_id, doc_id])
  @@map("fin_cash_bank_tx_line")
}

/// The PPh withheld on one line, per Jenis PPh — the unit one Bukti Potong
/// will be made from (P69).
model FinCashBankTxLineWht {
  id                 Int     @id @default(autoincrement())
  line_id            Int
  withholding_tax_id Int
  rate               Decimal @db.Decimal(9, 4)
  base_amount        Decimal @db.Decimal(18, 2)
  amount             Decimal @db.Decimal(18, 2)

  line            FinCashBankTxLine @relation(fields: [line_id], references: [id], onDelete: Cascade)
  withholding_tax RefWithholdingTax @relation(fields: [withholding_tax_id], references: [id])

  @@unique([line_id, withholding_tax_id])
  @@map("fin_cash_bank_tx_line_wht")
}

// ---------------------------------------------------------------- AR items
//
// What a customer owes and has paid ahead, per document (Claude-ERP.md
// P71–P75). An AR item is the settlement unit: an Uang Muka is born when an
// advance is received, an Invoice when a Faktur Penjualan is posted. Its
// balance moves only through Buku Piutang, which is append-only. AP will have
// tables of its own.

enum ArItemType {
  Advance
  Invoice
}

/// Whether the item raises the customer's Piutang Usaha (Invoice) or lowers
/// it (Advance). Exposure = balance × direction.
enum ArDirection {
  Increase
  Decrease
}

/// What moved an AR item's balance. Refund, retur and DN/CN arrive when they
/// are built (P74).
enum ArEvent {
  Create
  Payment
  AdvanceUsed
  /// An Invoice item lowered by the Uang Muka its Invoice deducts (P117).
  AdvanceApplied
  /// A later payment of an advance bill raising the bill's one Uang Muka item (P133).
  AdvanceReceived
}

model FinArItem {
  id          Int         @id @default(autoincrement())
  /// `ARI/YYYY/MM/NNNN`, in the month of `item_date` — the item's name for
  /// people (U1).
  ar_item_no  String      @unique
  item_type   ArItemType
  direction   ArDirection
  partner_id  Int
  currency_id Int
  item_date   DateTime    @db.Date
  /// When an Invoice falls due, for Umur Piutang. None on an Uang Muka.
  due_date    DateTime?   @db.Date

  /// The document the item is **about** — the advance bill for an Uang Muka,
  /// the Faktur for an Invoice — and its number as it read then (U1). What
  /// created the item is its Create entry's document.
  source_doc_type_id Int
  source_doc_id      Int
  source_no          String
  /// The agreement the item is settled within — a Customer Order or a
  /// Pengajuan Perizinan (P137, Z20) — by the weak pair: an invoice uses only
  /// its own agreement's advances (P73, P78). It belongs to another module.
  scope_doc_type_id  Int?
  scope_doc_id       Int?

  /// What is still open, in the item's own currency: the sum of its Buku
  /// Piutang entries, updated in the same transaction as each (P72).
  current_balance Decimal @db.Decimal(18, 2)

  /// What the item was born at, fixed (P116): an Uang Muka its DPP received,
  /// an Invoice its face (DPP + PPN). The item keeps balances only; its tax
  /// lives on its tax document, read from the tax module when a page needs it.
  original_amount Decimal @default(0) @db.Decimal(18, 2)

  created_by Int
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  partner         MPartner      @relation(fields: [partner_id], references: [id])
  currency        RefCurrency   @relation(fields: [currency_id], references: [id])
  source_doc_type SysDocType    @relation("ArItemSource", fields: [source_doc_type_id], references: [id])
  scope_doc_type  SysDocType?   @relation("ArItemScope", fields: [scope_doc_type_id], references: [id])
  entries         FinArLedger[] @relation("ArItemEntries")
  counter_entries FinArLedger[] @relation("ArItemCounter")

  @@index([partner_id, item_type])
  @@index([scope_doc_type_id, scope_doc_id])
  @@index([source_doc_type_id, source_doc_id])
  @@map("fin_ar_item")
}

/// Buku Piutang — every change to an AR item's balance, append-only: an entry
/// is never edited or deleted (P72).
model FinArLedger {
  id            Int      @id @default(autoincrement())
  /// `BP/YYYY/MM/NNNN`, one per posting: the entries one document writes —
  /// a receipt's items, an Invoice's item and the advances it used — share it,
  /// a `line_no` each (P110).
  ledger_no     String
  line_no       Int
  item_id       Int
  event         ArEvent
  entry_date    DateTime @db.Date
  /// Always positive; `movement` carries the sign on the item's balance.
  amount        Decimal  @db.Decimal(18, 2)
  movement      Decimal  @db.Decimal(18, 2)
  balance_after Decimal  @db.Decimal(18, 2)

  /// The document that caused the entry, and its number.
  doc_type_id     Int
  doc_id          Int
  doc_no          String
  /// An advance used by an invoice names the Invoice item that took it.
  counter_item_id Int?
  note            String?

  created_by Int
  created_at DateTime @default(now()) @db.Timestamptz(6)

  item         FinArItem  @relation("ArItemEntries", fields: [item_id], references: [id])
  counter_item FinArItem? @relation("ArItemCounter", fields: [counter_item_id], references: [id])
  doc_type     SysDocType @relation(fields: [doc_type_id], references: [id])

  @@unique([ledger_no, line_no])
  @@index([item_id, entry_date])
  @@index([doc_type_id, doc_id])
  @@map("fin_ar_ledger")
}

// ---------------------------------------------------------------- tax (P100)
//
// The tax documents the sales process gives rise to (`tax_concept.md` §5, §6).
// They never post a journal: the receipt and the Invoice already booked the PPN
// and the PPh. Each is created automatically, inside the posting of the
// transaction at its tax point, with its figures copied from that source and
// never edited (Q16). Named only by `lib/erp/tax-document.ts`.

enum TaxFakturKind {
  /// Faktur uang muka — an advance received before delivery.
  Advance
  /// Faktur pelunasan — goods delivered after advances, net of them.
  Settlement
  /// Faktur normal — goods delivered with no advance deducted.
  Normal
}

/// One Faktur Pajak Keluaran. Its source is the posting that made the tax point:
/// a receipt line for an advance (with the bill it paid), an Invoice Penjualan
/// for goods. Buyer identity is snapshotted as it stood then.
model TaxFaktur {
  id        Int           @id @default(autoincrement())
  /// `FPK/YYYY/MM/NNNN`, in the month of `tax_date` — the internal number.
  faktur_no String        @unique
  kind      TaxFakturKind
  /// The tax point: the receipt date for an advance, the latest Tanggal Kirim for goods.
  tax_date  DateTime      @db.Date
  /// Upload by the 15th of the following month.
  deadline  DateTime      @db.Date

  customer_id    Int
  buyer_tax_type String?
  buyer_tax_id   String?
  buyer_name     String
  buyer_address  String

  /// What made it: the receipt (advance) or the Invoice (goods).
  source_doc_type_id Int
  source_doc_id      Int
  source_no          String
  /// What it is about beside that: the advance bill paid (advance only).
  ref_doc_type_id    Int?
  ref_doc_id         Int?
  ref_no             String?
  /// The Uang Muka AR item the advance created (advance only), so a later
  /// faktur pelunasan finds this faktur from the deduction.
  ar_item_id         Int?
  scope_doc_type_id  Int
  scope_doc_id       Int

  description               String?
  ppn_rate                  Decimal @db.Decimal(9, 4)
  ppn_dpp_other_numerator   Int
  ppn_dpp_other_denominator Int
  /// DPP of everything delivered (settlement / normal); equals `dpp` for an advance.
  gross_dpp                 Decimal @db.Decimal(18, 2)
  /// The advances' DPP it deducts (settlement only).
  advance_dpp               Decimal @default(0) @db.Decimal(18, 2)
  /// The advances' PPN it deducts (settlement, full-less-advance P113).
  advance_ppn               Decimal @default(0) @db.Decimal(18, 2)
  dpp                       Decimal @db.Decimal(18, 2)
  dpp_other                 Decimal @db.Decimal(18, 2)
  ppn                       Decimal @db.Decimal(18, 2)

  /// Nomor Seri Faktur Pajak from Coretax — an optional reference the user
  /// fills in and may correct (P101); the faktur is a complete record without it.
  nsfp      String?   @unique
  /// The day it was uploaded to Coretax, when the user records it.
  nsfp_date DateTime? @db.Date
  nsfp_by   Int?

  created_by Int
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  customer MPartner        @relation(fields: [customer_id], references: [id])
  lines    TaxFakturLine[]
  refs     TaxFakturRef[]  @relation("FakturRefs")
  used_by  TaxFakturRef[]  @relation("FakturUsedBy")

  @@index([tax_date])
  @@index([source_doc_type_id, source_doc_id])
  @@index([ar_item_id])
  @@map("tax_faktur")
}

/// One line of a faktur pajak, as it is reported: the advance as one line, or
/// each Invoice line with its share of the advances deducted.
model TaxFakturLine {
  id          Int      @id @default(autoincrement())
  faktur_id   Int
  line_no     Int
  description String
  item_label  String?
  qty         Decimal? @db.Decimal(18, 4)
  uom_label   String?
  price       Decimal? @db.Decimal(18, 6)
  gross_dpp   Decimal  @db.Decimal(18, 2)
  advance_dpp Decimal  @default(0) @db.Decimal(18, 2)
  dpp         Decimal  @db.Decimal(18, 2)
  dpp_other   Decimal  @db.Decimal(18, 2)
  ppn         Decimal  @db.Decimal(18, 2)

  faktur TaxFaktur @relation(fields: [faktur_id], references: [id])

  @@unique([faktur_id, line_no])
  @@map("tax_faktur_line")
}

/// A faktur uang muka a faktur pelunasan deducts, and the DPP it takes from it.
model TaxFakturRef {
  id            Int     @id @default(autoincrement())
  faktur_id     Int
  ref_faktur_id Int
  dpp_deducted  Decimal @db.Decimal(18, 2)
  ppn_deducted  Decimal @default(0) @db.Decimal(18, 2)

  faktur     TaxFaktur @relation("FakturRefs", fields: [faktur_id], references: [id])
  ref_faktur TaxFaktur @relation("FakturUsedBy", fields: [ref_faktur_id], references: [id])

  @@unique([faktur_id, ref_faktur_id])
  @@map("tax_faktur_ref")
}

enum TaxSlipStatus {
  /// Menunggu Bukti Potong — late after its expected date.
  Awaiting
  /// Diterima — the customer's BPPU is in hand; the PPh can be credited.
  Received
}

/// One Bukti Potong PPh: one per settled document, per payment, per Jenis PPh
/// (P69, Q19), made when the receipt that recognised the withholding posts.
model TaxWithholdingSlip {
  id      Int           @id @default(autoincrement())
  /// `BPU/YYYY/MM/NNNN`, in the month of the payment — the internal number.
  slip_no String        @unique
  status  TaxSlipStatus @default(Awaiting)

  withheld_date DateTime @db.Date
  /// `YYYY-MM`, the payment's month.
  tax_period    String
  /// The withholder reports by the 20th of the following month.
  expected_date DateTime @db.Date

  customer_id         Int
  withholder_tax_type String?
  withholder_tax_id   String?
  withholder_name     String

  /// The receipt line's withholding row it comes from — one slip each.
  receipt_line_wht_id Int    @unique
  receipt_id          Int
  receipt_no          String
  /// The document the payment settled: an advance bill or an Invoice.
  doc_type_id         Int
  doc_id              Int
  doc_no              String

  withholding_tax_id Int
  rate               Decimal @db.Decimal(9, 4)
  base_amount        Decimal @db.Decimal(18, 2)
  amount             Decimal @db.Decimal(18, 2)

  /// The customer's slip (BPPU), recorded when it arrives.
  slip_number String?
  slip_date   DateTime? @db.Date
  received_by Int?

  created_by Int
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  customer        MPartner          @relation(fields: [customer_id], references: [id])
  withholding_tax RefWithholdingTax @relation(fields: [withholding_tax_id], references: [id])

  @@index([status, withheld_date])
  @@index([receipt_id])
  @@index([doc_type_id, doc_id])
  @@map("tax_withholding_slip")
}

// ------------------------------------------------------------ purchasing

/// A Purchase Request's lifecycle (Purchasing-Concept.md B8): no approval —
/// Ajukan makes it Open; it closes by hand or by itself once fully ordered.
enum ReceiptNoteStatus {
  Draft
  Posted
  Cancelled
}

enum PurchaseOrderStatus {
  Draft
  Submitted
  Open
  Closed
  Cancelled
  Rejected
}

enum PurchaseRequestStatus {
  Draft
  Open
  Closed
  Cancelled
}

/// A Purchase Request (`PR/YYYY/MM/NNNN`, P123): what someone needs bought, in
/// each item's base unit, by when. Barang or Jasa — one kind per request, shown
/// as two menus. No supplier, no price, no tax: those belong to the Purchase
/// Order, which is made only from Open requests. Posts nothing.
model PurRequest {
  id           Int                   @id @default(autoincrement())
  request_no   String                @unique
  request_date DateTime              @db.Date
  item_type    ItemType
  status       PurchaseRequestStatus @default(Draft)

  /// Who asked for it — free text, as the salesperson is (P52).
  requester     String?
  /// Barang only: where the goods are wanted, a hint for the receipt.
  warehouse_id  Int?
  /// The default each new line's Tanggal Dibutuhkan starts on.
  needed_date   DateTime @db.Date
  note          String?
  /// The reason given for Batalkan or Tutup.
  status_reason String?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  warehouse RefWarehouse?    @relation(fields: [warehouse_id], references: [id])
  lines     PurRequestLine[]

  @@index([item_type, status])
  @@map("pur_request")
}

/// One line of a Purchase Request: an item, its quantity in the base unit and
/// the date it is needed. `ordered_qty` is what Purchase Orders have taken of
/// it, written by the PO module through this module's function (as
/// `delivered_qty`, P94).
model PurRequestLine {
  id          Int      @id @default(autoincrement())
  request_id  Int
  line_no     Int
  item_id     Int
  /// The item's base unit, always (B7).
  uom_id      Int
  qty         Decimal  @db.Decimal(18, 4)
  needed_date DateTime @db.Date
  ordered_qty Decimal  @default(0) @db.Decimal(18, 4)
  note        String?

  request PurRequest            @relation(fields: [request_id], references: [id], onDelete: Cascade)
  item    MItem                 @relation(fields: [item_id], references: [id])
  uom     RefUom                @relation("PurRequestLineUom", fields: [uom_id], references: [id])
  orders  PurOrderLineRequest[]

  @@unique([request_id, line_no])
  @@index([item_id])
  @@map("pur_request_line")
}

/// The Purchase Order (P124, Purchasing-Concept.md B10–B16): one supplier, one
/// kind (Barang or Jasa), made only from Open Purchase Requests. Posts nothing.
model PurOrder {
  id         Int                 @id @default(autoincrement())
  /// `PO/YYYY/MM/NNNN`, `PO-NP/…` when not Kena PPN (P109).
  order_no   String              @unique
  order_date DateTime            @db.Date
  item_type  ItemType
  status     PurchaseOrderStatus @default(Draft)

  supplier_id   Int
  term_id       Int
  /// Tanggal Kirim Diharapkan.
  delivery_date DateTime @db.Date
  /// Gudang Tujuan, Barang only.
  warehouse_id  Int?
  /// The supplier's quotation number, a reference.
  quotation_no  String?

  is_taxable                Boolean   @default(true)
  price_mode                PriceMode
  /// Snapshotted at each save while Draft, frozen at Ajukan (P60).
  ppn_rate                  Decimal?  @db.Decimal(9, 4)
  ppn_dpp_other_numerator   Int?
  ppn_dpp_other_denominator Int?

  note String?

  gross_amount     Decimal @default(0) @db.Decimal(18, 2)
  discount_amount  Decimal @default(0) @db.Decimal(18, 2)
  dpp_amount       Decimal @default(0) @db.Decimal(18, 2)
  dpp_other_amount Decimal @default(0) @db.Decimal(18, 2)
  ppn_amount       Decimal @default(0) @db.Decimal(18, 2)
  total_amount     Decimal @default(0) @db.Decimal(18, 2)

  /// Why it was cancelled, rejected or closed by hand; null when fulfilled.
  status_reason String?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  supplier  MPartner       @relation("PurOrderSupplier", fields: [supplier_id], references: [id])
  term      RefPaymentTerm @relation("PurOrderTerm", fields: [term_id], references: [id])
  warehouse RefWarehouse?  @relation("PurOrderWarehouse", fields: [warehouse_id], references: [id])
  lines     PurOrderLine[]

  @@index([supplier_id])
  @@index([item_type, status])
  @@map("pur_order")
}

model PurOrderLine {
  id       Int @id @default(autoincrement())
  order_id Int
  line_no  Int

  item_id    Int
  /// Any unit of the item (B14); `uom_factor` converts to base, copied at save.
  uom_id     Int
  uom_factor Decimal @db.Decimal(18, 4)
  qty        Decimal @db.Decimal(18, 4)
  price      Decimal @db.Decimal(18, 6)

  discount_type    DiscountType?
  discount_value   Decimal?      @db.Decimal(18, 4)
  discount_amount  Decimal       @default(0) @db.Decimal(18, 2)
  amount           Decimal       @db.Decimal(18, 2)
  dpp_amount       Decimal       @db.Decimal(18, 2)
  dpp_other_amount Decimal       @default(0) @db.Decimal(18, 2)
  ppn_amount       Decimal       @db.Decimal(18, 2)

  /// A purchase Jenis PPh (P122), or null.
  withholding_tax_id Int?
  /// The rate applied: the master's, doubled for a supplier without NPWP (B12).
  withholding_rate   Decimal? @db.Decimal(9, 4)

  /// What posted Receipt Notes brought in, in this line's unit (step 4).
  received_qty Decimal @default(0) @db.Decimal(18, 4)

  note String?

  order           PurOrder              @relation(fields: [order_id], references: [id], onDelete: Cascade)
  item            MItem                 @relation("PurOrderLineItem", fields: [item_id], references: [id])
  uom             RefUom                @relation("PurOrderLineUom", fields: [uom_id], references: [id])
  withholding_tax RefWithholdingTax?    @relation("PurOrderLineWht", fields: [withholding_tax_id], references: [id])
  requests        PurOrderLineRequest[]

  @@unique([order_id, line_no])
  @@index([item_id])
  @@map("pur_order_line")
}

/// Which request lines a PO line covers, and how much of each in base units
/// (B9, B15): the line's base quantity shared earliest Tanggal Dibutuhkan
/// first; what is beyond them belongs to no request.
model PurOrderLineRequest {
  id              Int     @id @default(autoincrement())
  order_line_id   Int
  request_line_id Int
  base_qty        Decimal @default(0) @db.Decimal(18, 4)

  order_line   PurOrderLine   @relation(fields: [order_line_id], references: [id], onDelete: Cascade)
  request_line PurRequestLine @relation(fields: [request_line_id], references: [id])

  @@unique([order_line_id, request_line_id])
  @@index([request_line_id])
  @@map("pur_order_line_request")
}

/// The Receipt Note (P125, Purchasing-Concept.md B17–B22): goods or a service
/// received from a supplier. Standalone (P106): a purpose and a weak source
/// pair; its one purpose is `purchase_receipt`, from one Open Purchase Order.
model LogReceiptNote {
  id      Int               @id @default(autoincrement())
  /// `RN/YYYY/MM/NNNN`, `RN-NP/…` for a PO without PPN (P109).
  rn_no   String            @unique
  /// Tanggal Terima — the journal's date.
  rn_date DateTime          @db.Date
  status  ReceiptNoteStatus @default(Draft)

  purpose            String
  source_doc_type_id Int
  source_doc_id      Int
  source_no          String
  /// The supplier, copied from the source.
  partner_id         Int
  /// Where the goods come in; null for a Jasa receipt.
  warehouse_id       Int?
  /// The supplier's own delivery note number.
  supplier_dn_no     String?
  note               String?

  /// Σ of the lines' value, set at Posting.
  value_amount  Decimal @default(0) @db.Decimal(18, 2)
  journal_id    Int?
  cancel_reason String?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  source_doc_type SysDocType           @relation("ReceiptNoteSource", fields: [source_doc_type_id], references: [id])
  partner         MPartner             @relation("ReceiptNotePartner", fields: [partner_id], references: [id])
  warehouse       RefWarehouse?        @relation("ReceiptNoteWarehouse", fields: [warehouse_id], references: [id])
  lines           LogReceiptNoteLine[]

  @@index([source_doc_type_id, source_doc_id])
  @@index([purpose, status])
  @@index([status, rn_date])
  @@map("log_receipt_note")
}

model LogReceiptNoteLine {
  id                 Int @id @default(autoincrement())
  receipt_note_id    Int
  line_no            Int
  /// The source line, weak: for `purchase_receipt` a Purchase Order line.
  source_doc_line_id Int

  item_id      Int
  uom_id       Int
  uom_factor   Decimal @db.Decimal(18, 4)
  qty          Decimal @db.Decimal(18, 4)
  base_qty     Decimal @db.Decimal(18, 4)
  /// Enters the stock books (Barang with Kelola Stok); otherwise an expense.
  is_stock     Boolean @default(false)
  /// Its share of the source line's DPP, cumulative (B20); set at Posting.
  value_amount Decimal @default(0) @db.Decimal(18, 2)
  note         String?

  receipt_note LogReceiptNote      @relation(fields: [receipt_note_id], references: [id], onDelete: Cascade)
  item         MItem               @relation("ReceiptNoteLineItem", fields: [item_id], references: [id])
  uom          RefUom              @relation("ReceiptNoteLineUom", fields: [uom_id], references: [id])
  lots         LogReceiptNoteLot[]

  @@unique([receipt_note_id, line_no])
  @@unique([receipt_note_id, source_doc_line_id])
  @@index([source_doc_line_id])
  @@map("log_receipt_note_line")
}

/// The lots a stock line comes in as (B19): made here at Posting.
model LogReceiptNoteLot {
  id           Int       @id @default(autoincrement())
  line_id      Int
  lot_seq      Int
  /// Typed, or generated at Posting when left empty.
  lot_no       String?
  expiry_date  DateTime? @db.Date
  /// In the line's unit.
  qty          Decimal   @db.Decimal(18, 4)
  base_qty     Decimal   @default(0) @db.Decimal(18, 4)
  value_amount Decimal   @default(0) @db.Decimal(18, 2)
  /// The stock lot it became, set at Posting (weak: the inventory's table).
  tracking_id  Int?
  /// Where it is put, in a warehouse with Gunakan Lokasi (weak: a master the
  /// inventory checks at Posting).
  location_id  Int?

  line LogReceiptNoteLine @relation(fields: [line_id], references: [id], onDelete: Cascade)

  @@unique([line_id, lot_seq])
  @@map("log_receipt_note_lot")
}

/// Uang Muka Pembelian (P126, Purchasing-Concept.md B23): the supplier's
/// request for a down payment, drawn from one Open Purchase Order — the AR
/// advance bill mirrored (P58). A bill, not a transaction: it posts nothing.
model FinApAdvance {
  id           Int           @id @default(autoincrement())
  /// `APA/YYYY/MM/NNNN`, `APA-NP/…` for a PO without PPN (P109).
  advance_no   String        @unique
  advance_date DateTime      @db.Date
  due_date     DateTime      @db.Date
  status       AdvanceStatus @default(Draft)

  /// The Purchase Order, weak (another module's document, §3.1).
  purchase_order_id Int
  supplier_id       Int
  /// The supplier's proforma or invoice number for the down payment.
  supplier_ref_no   String?
  description       String
  note              String?

  price_mode                PriceMode
  is_taxable                Boolean
  ppn_rate                  Decimal?  @db.Decimal(9, 4)
  ppn_dpp_other_numerator   Int?
  ppn_dpp_other_denominator Int?

  amount_type  AdvanceAmountType
  amount_value Decimal           @db.Decimal(18, 4)

  amount           Decimal @db.Decimal(18, 2)
  dpp_amount       Decimal @db.Decimal(18, 2)
  dpp_other_amount Decimal @db.Decimal(18, 2)
  ppn_amount       Decimal @db.Decimal(18, 2)
  total_amount     Decimal @db.Decimal(18, 2)
  /// What posted payments have settled of it, cash + PPh (P132), as on the AR bill.
  paid_amount      Decimal @default(0) @db.Decimal(18, 2)

  cancel_reason String?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  supplier MPartner @relation("ApAdvanceSupplier", fields: [supplier_id], references: [id])

  @@index([purchase_order_id])
  @@index([supplier_id])
  @@index([status, advance_date])
  @@map("fin_ap_advance")
}

/// AP items (P127, Purchasing-Concept.md B32): the AR items mirrored (P71,
/// P58) — what the company owes a supplier per document, or has paid ahead.
/// An Uang Muka is born by a payment of an AP advance bill, an Invoice by a
/// posted Invoice Pembelian. Item type, direction and event reuse the AR enums:
/// the same shape on the other side. A book: kernel imports only.
model FinApItem {
  id          Int         @id @default(autoincrement())
  /// `API/YYYY/MM/NNNN`, in the month of `item_date`.
  ap_item_no  String      @unique
  item_type   ArItemType
  /// An Invoice raises Hutang Usaha, an Uang Muka lowers it.
  direction   ArDirection
  partner_id  Int
  currency_id Int
  item_date   DateTime    @db.Date
  due_date    DateTime?   @db.Date

  /// The document the item is about — the AP advance bill, the Invoice Pembelian.
  source_doc_type_id Int
  source_doc_id      Int
  source_no          String
  /// The Purchase Order it is settled within (weak): an invoice uses only its own PO's advances.
  purchase_order_id  Int?

  current_balance Decimal @db.Decimal(18, 2)
  original_amount Decimal @default(0) @db.Decimal(18, 2)

  created_by Int
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  partner         MPartner      @relation("ApItemPartner", fields: [partner_id], references: [id])
  currency        RefCurrency   @relation("ApItemCurrency", fields: [currency_id], references: [id])
  source_doc_type SysDocType    @relation("ApItemSource", fields: [source_doc_type_id], references: [id])
  entries         FinApLedger[] @relation("ApItemEntries")
  counter_entries FinApLedger[] @relation("ApItemCounter")

  @@index([partner_id, item_type])
  @@index([purchase_order_id])
  @@index([source_doc_type_id, source_doc_id])
  @@map("fin_ap_item")
}

/// Buku Hutang: every change to an AP item's balance, append-only (P127).
model FinApLedger {
  id            Int      @id @default(autoincrement())
  /// `BH/YYYY/MM/NNNN`, one per posting, a `line_no` each (P110).
  ledger_no     String
  line_no       Int
  item_id       Int
  event         ArEvent
  entry_date    DateTime @db.Date
  amount        Decimal  @db.Decimal(18, 2)
  movement      Decimal  @db.Decimal(18, 2)
  balance_after Decimal  @db.Decimal(18, 2)

  doc_type_id     Int
  doc_id          Int
  doc_no          String
  counter_item_id Int?
  note            String?

  created_by Int
  created_at DateTime @default(now()) @db.Timestamptz(6)

  item         FinApItem  @relation("ApItemEntries", fields: [item_id], references: [id])
  counter_item FinApItem? @relation("ApItemCounter", fields: [counter_item_id], references: [id])
  doc_type     SysDocType @relation("ApLedgerDocType", fields: [doc_type_id], references: [id])

  @@unique([ledger_no, line_no])
  @@index([item_id, entry_date])
  @@index([doc_type_id, doc_id])
  @@map("fin_ap_ledger")
}

/// Invoice Pembelian (P128, Purchasing-Concept.md B28–B31): the supplier's bill
/// for one Purchase Order, made of whole lines of its posted Receipt Notes at
/// the PO price — each line's DPP is its receipt's value, so Barang Diterima
/// Belum Ditagih clears exactly. The company's PPh is booked here (§4.3b).
model FinApInvoice {
  id           Int           @id @default(autoincrement())
  /// `PI/YYYY/MM/NNNN`, `PI-NP/…` for a PO without PPN (P109).
  invoice_no   String        @unique
  /// Tanggal — the journal date, not before the latest receipt.
  invoice_date DateTime      @db.Date
  /// Tanggal Invoice Supplier + the PO's Termin.
  due_date     DateTime      @db.Date
  status       InvoiceStatus @default(Draft)

  /// The Purchase Order, weak (another module's document, §3.1).
  purchase_order_id       Int
  supplier_id             Int
  /// The supplier's own invoice: number (unique per supplier among live invoices) and date.
  supplier_invoice_no     String
  supplier_invoice_date   DateTime @db.Date
  /// The supplier's faktur pajak number — a reference until the tax module makes it a record.
  supplier_tax_invoice_no String?

  price_mode                PriceMode
  is_taxable                Boolean
  ppn_rate                  Decimal?  @db.Decimal(9, 4)
  ppn_dpp_other_numerator   Int?
  ppn_dpp_other_denominator Int?

  dpp_amount         Decimal  @default(0) @db.Decimal(18, 2)
  advance_dpp_amount Decimal  @default(0) @db.Decimal(18, 2)
  advance_ppn_amount Decimal  @default(0) @db.Decimal(18, 2)
  net_dpp_amount     Decimal  @default(0) @db.Decimal(18, 2)
  dpp_other_amount   Decimal  @default(0) @db.Decimal(18, 2)
  /// Full PPN less the advances' PPN (P113).
  ppn_amount         Decimal  @default(0) @db.Decimal(18, 2)
  /// Our total: net DPP + PPN, before PPh.
  total_amount       Decimal  @default(0) @db.Decimal(18, 2)
  /// The PPh the company withholds, on the DPP after the advance (B31).
  pph_amount         Decimal  @default(0) @db.Decimal(18, 2)
  /// Total Tagihan Supplier as typed (B29b); null when not compared.
  supplier_total     Decimal? @db.Decimal(18, 2)
  /// Supplier total − ours, posted to Selisih Tagihan Supplier within the tolerance.
  difference_amount  Decimal  @default(0) @db.Decimal(18, 2)
  /// What Hutang Usaha is born at: full DPP + full PPN + difference − PPh.
  payable_amount     Decimal  @default(0) @db.Decimal(18, 2)
  /// What posted payments settled of it (P133): owed − paid = its AP item's balance.
  paid_amount        Decimal  @default(0) @db.Decimal(18, 2)

  journal_id    Int?
  ap_item_id    Int?
  note          String?
  cancel_reason String?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  supplier   MPartner                       @relation("ApInvoiceSupplier", fields: [supplier_id], references: [id])
  lines      FinApInvoiceLine[]
  deductions FinApInvoiceAdvanceDeduction[]

  @@index([purchase_order_id])
  @@index([supplier_id, supplier_invoice_no])
  @@index([status, invoice_date])
  @@map("fin_ap_invoice")
}

model FinApInvoiceLine {
  id                     Int      @id @default(autoincrement())
  invoice_id             Int
  line_no                Int
  /// A posted Receipt Note line, weak; each billed by at most one live invoice.
  receipt_note_line_id   Int
  purchase_order_line_id Int
  qty                    Decimal  @db.Decimal(18, 4)
  /// The PO line's price, for the record (B29a).
  price                  Decimal  @db.Decimal(18, 6)
  /// The receipt's value — the PO's DPP for this quantity.
  dpp_amount             Decimal  @db.Decimal(18, 2)
  advance_dpp_amount     Decimal  @default(0) @db.Decimal(18, 2)
  net_dpp_amount         Decimal  @db.Decimal(18, 2)
  dpp_other_amount       Decimal  @default(0) @db.Decimal(18, 2)
  ppn_amount             Decimal  @default(0) @db.Decimal(18, 2)
  withholding_tax_id     Int?
  withholding_rate       Decimal? @db.Decimal(9, 4)

  invoice FinApInvoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@unique([invoice_id, line_no])
  @@unique([invoice_id, receipt_note_line_id])
  @@index([receipt_note_line_id])
  @@index([purchase_order_line_id])
  @@map("fin_ap_invoice_line")
}

model FinApInvoiceAdvanceDeduction {
  id         Int     @id @default(autoincrement())
  invoice_id Int
  ap_item_id Int
  ap_item_no String
  dpp_used   Decimal @db.Decimal(18, 2)
  ppn_used   Decimal @default(0) @db.Decimal(18, 2)

  invoice FinApInvoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@unique([invoice_id, ap_item_id])
  @@index([ap_item_id])
  @@map("fin_ap_invoice_advance_deduction")
}
