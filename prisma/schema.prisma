// ERP — Prisma schema
//
// Carried from SIBA 3.0 (Claude-ERP.md §13): one installation serves one
// company, so no table carries a company (P9); Budget, its classification and
// the subject books are not carried (P10, P25).
//
// Translated from `Initialization/SIBA 3.0 DBML.txt` (MySQL-flavoured DBML),
// which is reference material rather than gospel: where the application needs a
// column the DBML lacks, the column is added and the reason recorded here.
//
// Deliberate deviations from the source DBML:
//   * `datetime`            -> DateTime @db.Timestamptz(6)
//   * inline `enum(...)`    -> native Postgres enums
//   * `bigint` ids          -> Int (avoids BigInt serialization pain across the
//                             server/client boundary; ample for this domain)
//   * money `decimal(18,6)` -> Decimal(18,2). The DBML used (18,6) only on
//                             budget_amount / realized_amount; every other money
//                             column was (18,2). Treated as a typo. Exchange
//                             rates keep (18,6).
//   * created_by/updated_by stay plain Int with no FK, exactly as the DBML
//                             declares them (it defines no ref for these).
//
// Additions the application requires but the DBML lacks:
//   * SysUser                      — nothing in the DBML backs created_by/updated_by
//   * AccAccount.partner_category_id       — one account holds one partner category
//   * AuditLog                     — one trail spanning every table
//   * SysRole / SysPermission / SysUserRole / SysRolePermission / SysSession
//                                  — authentication and RBAC; the DBML has no
//                             authentication model at all
//
// Dropped vs the DBML:
//   * AccAccount.partner_type — flagged `// diganti nanti` in the source and
//     superseded by partner_category_id.
//
// Not yet modelled (present in the DBML and/or the concept doc):
//   general_ledger — deliberately. The General Ledger is derived from
//   acc_journal_line rather than stored.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums

enum ActiveStatus {
  Active
  Inactive
}

enum CashBankType {
  Cash
  Bank
}

enum NormalBalance {
  Debit
  Kredit
}

/// Which statement an account type belongs to, and therefore whether the
/// accounts beneath it are closed out at the end of a fiscal year.
///
/// Stored rather than read off the first segment of a lineage code. The
/// convention — `4` and `5` are Laba Rugi — happens to hold, and a
/// convention that merely happens to hold is one a future maintainer can break
/// with nothing failing. A column is a fact the database can be asked for.
enum AccountSection {
  BalanceSheet
  ProfitLoss
}

/// Which step of the multi-step Laba Rugi an Account Category sits in.
///
/// Declared in this order on purpose: it is the order the statement reads,
/// and each subtotal — Laba Kotor after HPP, Laba Usaha after Beban Usaha,
/// Laba Bersih after Beban Lain-lain — closes the steps above it. Stored on
/// the category rather than read off its number for the same reason `section`
/// is: `5.1` being HPP is a convention, and a convention that merely holds
/// can be broken with nothing failing.
enum ProfitLossGroup {
  OperatingRevenue
  CostOfSales
  OperatingExpense
  OtherIncome
  OtherExpense
}

enum FiscalStatus {
  Draft
  Open
  Closed
}

/// Whether a fiscal year has been closed.
///
/// Deliberately not `FiscalStatus`: a closing has no Draft. A year is either
/// still receiving postings or it never will again.
enum FiscalClosingStatus {
  Open
  Closed
}

enum FlowDirection {
  In
  Out
}

enum AuditAction {
  TAMBAH
  UPDATE
  HAPUS
}

/// Who a Partner is in the eyes of the tax office. Decides which identity a
/// faktur may carry: a Badan or an Instansi Pemerintah is known by its NPWP,
/// an Orang Pribadi by its NPWP or its NIK.
enum TaxpayerType {
  Badan
  OrangPribadi
  InstansiPemerintah
}

/// Which number identifies the Partner to the tax office. Both are 16 digits
/// since the NPWP-16 change, which is exactly why the kind is stored beside
/// the number rather than guessed from its length.
enum TaxIdType {
  NPWP
  NIK
}

/// Whether a customer collects the PPN on what it buys instead of paying it
/// (Pemungut PPN / WAPU). Only a government collector for now: its faktur
/// carries kode transaksi 02 and its payment arrives short by the PPN
/// (Claude-ERP.md §10.2 rule 3, simulation `wapu: 'G'`).
enum VatCollector {
  None
  Government
}

/// How the prices on a sales document are typed: before PPN or with it
/// already in (the simulation's `EXC` / `INC`). Chosen on each Sales Order; a
/// customer may carry a default.
enum PriceMode {
  Exclude
  Include
}

/// Where a Sales Order is in its life (P63): Draft → Submitted → Open →
/// Closed. Cancelled (from Draft) and Rejected (from Submitted) are final.
enum SalesOrderStatus {
  Draft
  Submitted
  Open
  Closed
  Cancelled
  Rejected
}

/// How a line's discount was typed: a percentage of the line, or an amount.
enum DiscountType {
  Percent
  Amount
}

/// Where an advance bill is in its life (P57). Issuing posts nothing; the
/// money, when it comes, is recorded by Pembayaran.
enum AdvanceStatus {
  Draft
  Issued
  Cancelled
}

/// How an advance's value was typed: a percentage of its order's value, or a
/// flat value in the order's price mode (P55). Shared by the AR advance and,
/// later, the AP advance, which mirror each other (P58).
enum AdvanceAmountType {
  Percent
  Amount
}

/// What an Item is. Decides which Kategori it may take, whether it can be
/// stock-managed, and — by rule on the transaction — which PPh a withholding
/// customer applies (Barang → PPh 22, Jasa → PPh 23). `Aset` joins later.
enum ItemType {
  Barang
  Jasa
}

// ---------------------------------------------------------------- auth & access
//
// RBAC: USER -> ROLE -> PERMISSION. A permission is one atomic capability; a
// role bundles permissions; a user holds roles. Roles are the only path to a
// permission — there is deliberately no direct user->permission grant, so the
// authorization model has exactly one source of truth.
//
// None of this is in the source DBML, which has no authentication model at all.

model SysUser {
  id            Int          @id @default(autoincrement())
  user_code     String       @unique
  /// The login identifier.
  email         String       @unique
  name          String
  initials      String
  /// bcrypt. Never selected into anything that crosses to a client component.
  password_hash String
  status        ActiveStatus @default(Active)

  /// Nullable, unlike the other masters: the bootstrap admin has no creator.
  created_by Int?
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  roles    SysUserRole[]
  sessions SysSession[]

  @@map("sys_user")
}

model SysRole {
  id         Int          @id @default(autoincrement())
  role_code  String       @unique
  /// Stable key referenced from application code (ADMIN, STAFF). Immutable on
  /// system roles, so `src/lib/siba/roles.ts` can rely on it.
  role_label String       @unique
  role_name  String
  /// Seeded roles. ADMIN is frozen: it always carries the whole catalogue and
  /// cannot be deactivated, which is what guarantees the application always has
  /// a way to administer users.
  is_system  Boolean      @default(false)
  note       String?
  status     ActiveStatus @default(Active)

  created_by Int?
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  users       SysUserRole[]
  permissions SysRolePermission[]

  @@map("sys_role")
}

/// Catalogue rows, owned by `src/lib/siba/permissions.ts` and synced by the
/// seed. Users never create or edit permissions, so this table carries no
/// status and no authorship — it is code, materialised for referential
/// integrity and for the role matrix to read names from.
model SysPermission {
  id              Int     @id @default(autoincrement())
  /// The stable code business logic asks for, e.g. `USER_CREATE`. Deliberately
  /// not a `<prefix>.<4 digits>` system code: nothing generates these.
  permission_code String  @unique
  permission_name String
  /// Grouping key, matching a nav module where one exists.
  module          String
  description     String?

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  roles SysRolePermission[]

  @@index([module])
  @@map("sys_permission")
}

/// System defaults — what the application prefills and assumes when the user
/// has not said otherwise. One row per setting key.
///
/// The catalogue of keys lives in code (`lib/siba/system-defaults.ts`), the way
/// the permission catalogue does: a setting is a branch in the code, so a row
/// nothing reads would be a setting nobody implemented. This table holds only
/// what each key is currently set to. Values are text because the catalogue
/// says how to read them — a `ref` setting stores a row id.
///
/// Not in the source DBML, which has no settings table at all.
model SysSetting {
  id            Int     @id @default(autoincrement())
  setting_key   String  @unique
  setting_value String?

  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("sys_setting")
}

/// A grant, not master data: revoking removes the row and writes an audit entry.
model SysUserRole {
  id      Int @id @default(autoincrement())
  user_id Int
  role_id Int

  created_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user SysUser @relation(fields: [user_id], references: [id])
  role SysRole @relation(fields: [role_id], references: [id])

  @@unique([user_id, role_id])
  @@index([user_id])
  @@map("sys_user_role")
}

/// A grant, not master data — same reasoning as SysUserRole.
model SysRolePermission {
  id            Int @id @default(autoincrement())
  role_id       Int
  permission_id Int

  created_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  role       SysRole       @relation(fields: [role_id], references: [id])
  permission SysPermission @relation(fields: [permission_id], references: [id])

  @@unique([role_id, permission_id])
  @@index([role_id])
  @@map("sys_role_permission")
}

/// Server-side sessions. The cookie carries an opaque random token; only its
/// SHA-256 is stored, so a database leak does not hand out live sessions.
/// Revocation is immediate because every request re-reads this row.
model SysSession {
  id           Int       @id @default(autoincrement())
  token_hash   String    @unique
  user_id      Int
  expires_at   DateTime  @db.Timestamptz(6)
  last_seen_at DateTime  @default(now()) @db.Timestamptz(6)
  /// Set on logout, on password change, and when the user is deactivated.
  revoked_at   DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)

  user SysUser @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([expires_at])
  @@map("sys_session")
}

// ---------------------------------------------------------------- sys

model SysAccountType {
  id             Int            @id @default(autoincrement())
  type_code      String         @unique
  type_label     String         @unique
  type_name      String
  /// Neraca or Laba Rugi. Seeded, never edited, never offered on a form: which
  /// statement a type belongs to is not a judgement call.
  section        AccountSection
  /// Which side the type's own total reads positive on — AKTIVA and BIAYA
  /// debit, PASIVA, EKUITAS and PENDAPATAN credit. The Neraca signs every row
  /// under a type by it, which is what prints Akumulasi Penyusutan (a Kredit
  /// account inside AKTIVA) as the deduction it is. Seeded, never edited, on no
  /// form; stored rather than read off the type's number for the reason
  /// `section` is.
  normal_balance NormalBalance
  note           String?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  account_categories AccAccountCategory[]

  @@map("sys_account_type")
}

model SysDocType {
  id        Int     @id @default(autoincrement())
  doc_code  String  @unique
  doc_label String
  doc_name  String
  doc_table String
  note      String?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  ledger_entries     CashBankLedger[]
  journals           AccJournal[]
  cash_bank_tx_lines FinCashBankTxLine[]
  ar_item_sources    FinArItem[]         @relation("ArItemSource")
  ar_item_refs       FinArItem[]         @relation("ArItemRef")
  ar_ledger_entries  FinArLedger[]

  @@map("sys_doc_type")
}

model SysPartnerCategory {
  id             Int          @id @default(autoincrement())
  category_code  String       @unique
  category_label String
  category_name  String
  note           String?
  status         ActiveStatus @default(Active)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  partners MPartner[]
  accounts AccAccount[]

  @@map("sys_partner_category")
}

// ---------------------------------------------------------------- ref

model RefCurrency {
  id             Int          @id @default(autoincrement())
  currency_code  String       @unique
  currency_label String
  currency_name  String
  note           String?
  status         ActiveStatus @default(Active)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  cash_banks    MCashBank[]
  journal_lines AccJournalLine[]
  ar_items      FinArItem[]

  @@map("ref_currency")
}

/// Satuan — a unit an item is counted in (PCS, BOX, SET). Only the unit; how
/// many of one make another depends on the item (a box of serum is 12 pcs, a
/// box of facial wash 24), so conversions live on the item.
model RefUom {
  id        Int          @id @default(autoincrement())
  uom_code  String       @unique
  uom_label String
  uom_name  String
  note      String?
  status    ActiveStatus @default(Active)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  base_items MItem[]    @relation("ItemBaseUom")
  item_uoms  MItemUom[]

  sales_order_lines SalOrderLine[]

  @@map("ref_uom")
}

/// Kategori Item — system data, seeded, with no menu (P47). Each belongs to one
/// Item Type, and an item may only take a category of its own type. The
/// account mapping per category is its own menu, later.
model SysItemCategory {
  id             Int          @id @default(autoincrement())
  category_code  String       @unique
  category_label String       @unique
  category_name  String
  item_type      ItemType
  status         ActiveStatus @default(Active)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  items MItem[]

  @@index([item_type])
  @@map("sys_item_category")
}

/// An Item — a barang or a jasa the company sells (and later buys). It holds no
/// price (typed on the document, P43) and no tax treatment: Kena PPN and the
/// Jenis PPh are decided on each transaction (P45, P48).
model MItem {
  id          Int      @id @default(autoincrement())
  item_code   String   @unique
  item_label  String
  item_name   String
  item_type   ItemType
  category_id Int
  /// The unit quantities are counted in; every conversion is to this unit.
  base_uom_id Int

  /// Offered on a Sales Order.
  can_sell    Boolean @default(true)
  /// Offered on purchasing documents, once they exist.
  can_buy     Boolean @default(false)
  /// Barang only. Stored now; stock itself is ignored until P5 is lifted.
  track_stock Boolean @default(false)
  /// Barang only. Batch / expiry tracking, meaningful once stock exists.
  has_expiry  Boolean @default(false)

  note   String?
  status ActiveStatus @default(Active)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  category SysItemCategory @relation(fields: [category_id], references: [id])
  base_uom RefUom          @relation("ItemBaseUom", fields: [base_uom_id], references: [id])
  uoms     MItemUom[]

  sales_order_lines SalOrderLine[]

  @@index([category_id])
  @@index([base_uom_id])
  @@map("m_item")
}

/// An alternate unit of an Item and how many base units it holds: a BOX of
/// this serum is 12 PCS. Part of the Item — saved with it, one audit entry.
model MItemUom {
  id         Int     @id @default(autoincrement())
  item_id    Int
  uom_id     Int
  /// Base units in one of this unit. More than 0.
  factor     Decimal @db.Decimal(18, 4)
  sort_order Int     @default(0)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  item MItem  @relation(fields: [item_id], references: [id])
  uom  RefUom @relation(fields: [uom_id], references: [id])

  @@unique([item_id, uom_id])
  @@index([uom_id])
  @@map("m_item_uom")
}

/// Termin Pembayaran — how long a customer has to pay. `due_days` after the
/// invoice date is the due date; `0` is Tunai.
model RefPaymentTerm {
  id         Int          @id @default(autoincrement())
  term_code  String       @unique
  term_label String
  term_name  String
  due_days   Int
  note       String?
  status     ActiveStatus @default(Active)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  partners     MPartner[]
  sales_orders SalOrder[]

  @@map("ref_payment_term")
}

/// Gudang — where goods ship from. Code and name only while stock is ignored
/// (P5); it is the Surat Jalan's origin, not yet a place stock is counted.
model RefWarehouse {
  id              Int          @id @default(autoincrement())
  warehouse_code  String       @unique
  warehouse_label String
  warehouse_name  String
  note            String?
  status          ActiveStatus @default(Active)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("ref_warehouse")
}

/// Jenis PPh — an income tax a customer withholds from what it pays (PPh 22,
/// PPh 23, PPh 4(2) …): its rate, what it is levied on, and the prepaid-tax
/// account the withheld amount is booked to until the bukti potong credits it.
/// The common types are seeded; users edit them and add their own (P44).
model RefWithholdingTax {
  id                 Int          @id @default(autoincrement())
  wht_code           String       @unique
  wht_label          String
  wht_name           String
  /// Percent, e.g. `1.5` for 1,5 %.
  rate               Decimal      @db.Decimal(9, 4)
  /// What the tax is levied on — the objek pajak, in words.
  tax_object         String?
  /// "PPh … Dibayar Dimuka". Optional here because a fresh chart of accounts
  /// has none yet; the document that books a withholding requires it.
  prepaid_account_id Int?
  note               String?
  status             ActiveStatus @default(Active)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  prepaid_account AccAccount? @relation(fields: [prepaid_account_id], references: [id])

  sales_order_lines SalOrderLine[]
  cash_bank_tx_whts FinCashBankTxLineWht[]

  @@index([prepaid_account_id])
  @@map("ref_withholding_tax")
}

// ---------------------------------------------------------------- master

model MPartner {
  id            Int          @id @default(autoincrement())
  partner_code  String       @unique
  partner_label String
  partner_name  String
  category_id   Int
  note          String?
  status        ActiveStatus @default(Active)

  // ---- Pajak: the identity a faktur pajak or a bukti potong names. Shared by
  // every role a Partner plays, so it sits on the Partner itself. Nullable only
  // because rows created before these columns existed have none; the Server
  // Action requires them on every save.
  taxpayer_type TaxpayerType?
  is_pkp        Boolean       @default(false)
  tax_id_type   TaxIdType?
  /// 16 digits, stored without separators.
  tax_id        String?
  /// The name registered with the tax office, which a faktur prints — it can
  /// differ from the trading name (`partner_name`).
  tax_name      String?

  // ---- Pajak, customer side: what a customer does with the tax on a sale.
  // Applies only when the category is Customer; false / null otherwise.
  /// The customer withholds PPh 23 on services it buys.
  withholds_pph23 Boolean       @default(false)
  /// The customer collects PPh 22 on goods it buys.
  collects_pph22  Boolean       @default(false)
  vat_collector   VatCollector?

  // ---- Penjualan, customer side: what a new Sales Order starts from (P51).
  // Both are defaults only; the Sales Order can change them.
  default_term_id    Int?
  default_price_mode PriceMode?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  category     SysPartnerCategory @relation(fields: [category_id], references: [id])
  default_term RefPaymentTerm?    @relation(fields: [default_term_id], references: [id])

  addresses MPartnerAddress[]
  contacts  MPartnerContact[]

  sales_orders   SalOrder[]
  sales_advances SalAdvance[]
  cash_bank_txs  FinCashBankTx[]
  ar_items       FinArItem[]

  journal_lines AccJournalLine[]

  opening_balance_lines AccOpeningBalanceLine[]

  @@index([category_id])
  @@map("m_partner")
}

/// One of a Partner's addresses. A Partner has at least one; the Server
/// Action enforces it, since a database constraint cannot count child rows.
///
/// Only the kelurahan / desa is stored: kecamatan, kota and provinsi follow
/// from it, and so does the kode pos. Storing them again would let an address
/// claim a kecamatan its own kelurahan does not sit in.
///
/// Part of the Partner record — written with it in one transaction, and its
/// changes are the Partner's own audit entry.
model MPartnerAddress {
  id          Int     @id @default(autoincrement())
  partner_id  Int
  village_id  Int
  /// The street part, typed by hand: jalan, nomor, blok, RT/RW, gedung.
  street      String
  note        String?
  /// The address a faktur is addressed to (Alamat Penagihan).
  is_billing  Boolean @default(false)
  /// An address goods can be delivered to (Alamat Pengiriman).
  is_shipping Boolean @default(false)
  /// Display order within the Partner, as the user arranged it.
  sort_order  Int     @default(0)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  partner MPartner         @relation(fields: [partner_id], references: [id])
  village SysRegionVillage @relation(fields: [village_id], references: [id])

  /// Documents that name this address. While any does, it cannot be removed
  /// from the Partner (P53).
  sales_orders SalOrder[]

  @@index([partner_id])
  @@index([village_id])
  @@map("m_partner_address")
}

/// A person to talk to at the Partner. Part of the Partner record, like its
/// addresses.
model MPartnerContact {
  id           Int    @id @default(autoincrement())
  partner_id   Int
  contact_name String
  position     String
  phone        String
  email        String
  sort_order   Int    @default(0)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  partner MPartner @relation(fields: [partner_id], references: [id])

  @@index([partner_id])
  @@map("m_partner_contact")
}

// ------------------------------------------------------------- regions
//
// Indonesia's administrative regions, Kepmendagri No. 300.2.2-2430 Tahun 2025,
// with the kode pos of each kelurahan / desa. System reference data: seeded
// from `prisma/data/region.tsv.gz`, never edited in the application. `code` is
// the Kemendagri code (`11`, `11.01`, `11.01.01`, `11.01.01.2001`), which is
// what the seed matches on, so re-seeding a newer edition updates names in
// place rather than duplicating them.

model SysRegionProvince {
  id   Int    @id @default(autoincrement())
  code String @unique
  name String

  cities SysRegionCity[]

  @@map("sys_region_province")
}

model SysRegionCity {
  id          Int    @id @default(autoincrement())
  code        String @unique
  name        String
  province_id Int

  province  SysRegionProvince   @relation(fields: [province_id], references: [id])
  districts SysRegionDistrict[]

  @@index([province_id])
  @@map("sys_region_city")
}

/// Kecamatan.
model SysRegionDistrict {
  id      Int    @id @default(autoincrement())
  code    String @unique
  name    String
  city_id Int

  city     SysRegionCity      @relation(fields: [city_id], references: [id])
  villages SysRegionVillage[]

  @@index([city_id])
  @@map("sys_region_district")
}

/// Kelurahan or desa.
model SysRegionVillage {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String
  district_id Int
  /// Null where the source has none.
  postal_code String?

  district  SysRegionDistrict @relation(fields: [district_id], references: [id])
  addresses MPartnerAddress[]

  @@index([district_id])
  @@map("sys_region_village")
}

model MCashBank {
  id              Int          @id @default(autoincrement())
  cash_bank_code  String       @unique
  cash_bank_label String
  cash_bank_name  String
  cash_bank_type  CashBankType
  currency_id     Int
  account_id      Int
  note            String?
  status          ActiveStatus @default(Active)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  currency RefCurrency @relation(fields: [currency_id], references: [id])
  account  AccAccount  @relation(fields: [account_id], references: [id])

  ledger       CashBankLedger[]
  book_balance CashBankBalance?
  transactions FinCashBankTx[]

  /// Advance bills that print this account as where to pay (P56).
  sales_advances SalAdvance[]

  @@map("m_cash_bank")
}

// ---------------------------------------------------------------- cash bank book
//
// The Cash Bank Book: an independent, append-only record of every movement
// through a cash or bank resource, plus the balance it adds up to.
//
// `cash_bank_ledger` is the truth. Entries are never edited and never deleted —
// a mistake is corrected by a further entry, which is what makes the book
// auditable. `cash_bank_balance` is a materialised running total kept in step
// inside the same transaction as the entry that moved it, so reading a balance
// costs one row instead of a scan.
//
// The concept doc requires this book to stay independent of the journal: it is
// never a view over journal lines. Only the General Ledger derives from
// journals.

enum CashBankEntryType {
  /// The balance a resource starts with, written once when it is registered.
  Opening
  /// A posted cash/bank transaction.
  Transaction
  /// A manual correction, recorded rather than edited into an existing entry.
  Adjustment
}

model CashBankLedger {
  id           Int               @id @default(autoincrement())
  entry_no     String            @unique
  cash_bank_id Int
  entry_date   DateTime          @db.Date
  entry_type   CashBankEntryType
  direction    FlowDirection

  /// Always positive; `direction` carries the sign.
  amount        Decimal @db.Decimal(18, 2)
  /// The same figure, signed: +In, -Out. Summing this column reconstructs the
  /// balance from scratch, which is how the materialised total is verified.
  movement      Decimal @db.Decimal(18, 2)
  /// Balance after this entry, in the resource's own currency.
  balance_after Decimal @db.Decimal(18, 2)

  /// The kurs this movement was valued at, always converting the resource's
  /// own currency to the base currency.
  ///
  /// **Money in** records the kurs it was received at, and `base_amount` is
  /// `amount × rate`. **Money out** records the resource's moving average
  /// (`base_balance ÷ balance`) at the moment it was posted, whatever date the
  /// entry carries — a backdated payment is valued at the average as it stood
  /// when it was entered (Claude-ERP.md P37). Its `base_amount` is what the
  /// pool released, which can differ from `amount × rate` by a rounding unit,
  /// and emptying the resource releases its remaining base exactly.
  ///
  /// **This book's own rate**, not necessarily the one another book recorded
  /// for the same document. A payment has two rates that need not agree — what
  /// the cash cost and what the obligation was carried at — and putting both on
  /// one row would make that row's own arithmetic fail. Each book takes the
  /// rate belonging to its own side, so the book stays independently
  /// re-derivable. The two sides meet in the journal, and the residual is
  /// recognised there.
  ///
  /// `1` means the money is base currency, and nothing else: a rate of 1
  /// between two foreign amounts would assert that USD 100 is IDR 100.
  rate               Decimal @db.Decimal(18, 6)
  /// `amount` in base currency. Stored rather than derived: base value is a
  /// record of how the balance was built, and re-deriving it at a current rate
  /// would destroy the only figure that says what currency movement cost.
  base_amount        Decimal @db.Decimal(18, 2)
  /// `movement` in base currency — signed, and summing it rebuilds the base
  /// balance exactly as `movement` rebuilds the foreign one.
  base_movement      Decimal @db.Decimal(18, 2)
  /// `balance_after` in base currency.
  base_balance_after Decimal @db.Decimal(18, 2)

  /// What caused the movement. Null for an opening balance, which has no
  /// source document — the registration of the resource is the event.
  source_doc_type_id Int?
  source_doc_id      Int?

  note String?

  created_by Int
  created_at DateTime @default(now()) @db.Timestamptz(6)

  cash_bank       MCashBank   @relation(fields: [cash_bank_id], references: [id])
  source_doc_type SysDocType? @relation(fields: [source_doc_type_id], references: [id])

  @@index([cash_bank_id, entry_date])
  @@index([source_doc_type_id, source_doc_id])
  @@map("cash_bank_ledger")
}

/// One row per cash/bank resource, derived from `cash_bank_ledger` and written
/// in the same transaction as the entry that changed it. Never written on its
/// own: `rebuildCashBankBalance` recomputes it from the ledger.
model CashBankBalance {
  cash_bank_id    Int       @id
  balance         Decimal   @default(0) @db.Decimal(18, 2)
  /// The same balance in base currency. A resource's carrying rate is
  /// `base_balance ÷ balance`, derived on read and never stored — it is an
  /// effective rate that will generally equal no rate anyone transacted at.
  base_balance    Decimal   @default(0) @db.Decimal(18, 2)
  entry_count     Int       @default(0)
  last_entry_id   Int?
  last_entry_date DateTime? @db.Date

  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  cash_bank MCashBank @relation(fields: [cash_bank_id], references: [id])

  @@map("cash_bank_balance")
}

// ---------------------------------------------------------------- accounting

model AccAccountCategory {
  id              Int              @id @default(autoincrement())
  account_type_id Int
  category_code   String           @unique
  /// The category's place in the chart of accounts: its account type's code
  /// plus one segment, e.g. `1.1` under type `1`. Not in the DBML, which
  /// carried no numbering scheme — see lib/siba/account-code.ts.
  category_label  String           @unique
  category_name   String
  /// The Laba Rugi step this category belongs to. Set exactly when the
  /// category's type is `ProfitLoss`, null on every Neraca category. Seeded
  /// from Template COA Sheet1, never edited, on no form — an account inherits
  /// its step through subcategory -> category, so a new account needs no setup.
  pl_group        ProfitLossGroup?
  note            String?
  status          ActiveStatus     @default(Active)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  account_type  SysAccountType          @relation(fields: [account_type_id], references: [id])
  subcategories AccAccountSubcategory[]

  @@index([account_type_id])
  @@map("acc_account_category")
}

model AccAccountSubcategory {
  id                  Int          @id @default(autoincrement())
  account_category_id Int
  subcategory_code    String       @unique
  /// Its category's code plus one segment, e.g. `1.1.1`. Every account
  /// number starts from one of these, so it is unique across the chart.
  subcategory_label   String       @unique
  subcategory_name    String
  note                String?
  status              ActiveStatus @default(Active)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  account_category AccAccountCategory @relation(fields: [account_category_id], references: [id])
  accounts         AccAccount[]

  @@index([account_category_id])
  @@map("acc_account_subcategory")
}

model AccAccount {
  id                     Int           @id @default(autoincrement())
  account_subcategory_id Int
  account_code           String        @unique
  /// The account number, continuing whatever the account hangs under: its
  /// subcategory's code (`1.1.1` -> `1.1.1.2`) or its parent account's
  /// (`1.1.1.2` -> `1.1.1.2.1`). Unique across the chart — see @@unique
  /// below. The DBML only constrained the generated account_code globally.
  account_label          String
  account_name           String
  parent_account         Int?
  is_postable            Boolean       @default(true)
  normal_balance         NormalBalance
  require_partner        Boolean       @default(false)
  /// Not in the DBML. Locks a partner-bearing account to a single partner category so
  /// subject histories never mix. Replaces the DBML's `partner_type`.
  partner_category_id    Int?
  is_control_account     Boolean       @default(false)
  note                   String?
  is_active              Boolean       @default(true)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  account_subcategory AccAccountSubcategory @relation(fields: [account_subcategory_id], references: [id])
  partner_category    SysPartnerCategory?   @relation(fields: [partner_category_id], references: [id])
  parent              AccAccount?           @relation("AccountTree", fields: [parent_account], references: [id])
  children            AccAccount[]          @relation("AccountTree")

  cash_banks    MCashBank[]
  journal_lines AccJournalLine[]

  opening_balance_lines AccOpeningBalanceLine[]

  withholding_taxes RefWithholdingTax[]

  @@unique([account_label])
  @@index([account_subcategory_id])
  @@map("acc_account")
}

model AccFiscalYear {
  id         Int          @id @default(autoincrement())
  year_code  String       @unique
  year_label String
  year_name  String
  start_date DateTime     @db.Date
  end_date   DateTime     @db.Date
  note       String?
  status     FiscalStatus @default(Draft)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  periods  AccFiscalPeriod[]
  closings AccFiscalClosing[]

  /// The snapshot this year opens with, and the snapshots this year's own
  /// close produced for the year after it. Two relations to one table, so
  /// each is named — see `AccOpeningBalance`.
  opening_balances         AccOpeningBalance[] @relation("OpeningBalanceYear")
  sourced_opening_balances AccOpeningBalance[] @relation("OpeningBalanceSource")

  @@map("acc_fiscal_year")
}

model AccFiscalPeriod {
  id             Int          @id @default(autoincrement())
  fiscal_year_id Int
  sequence_no    Int
  period_code    String       @unique
  period_label   String
  period_name    String
  start_date     DateTime     @db.Date
  end_date       DateTime     @db.Date
  note           String?
  status         FiscalStatus @default(Draft)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  fiscal_year AccFiscalYear @relation(fields: [fiscal_year_id], references: [id])

  @@index([fiscal_year_id])
  @@map("acc_fiscal_period")
}

/// The closing state of one fiscal year, and what its close produced.
///
/// An explicit record rather than a status inferred from the existence of an
/// Opening Balance document. Inferring a fact from a row in another table is
/// the same habit `AccountSection` exists to stop: it works until somebody
/// writes that row for a second reason, and then nothing fails.
///
/// `AccFiscalYear.status` follows it: the year reads Closed once it is closed.
model AccFiscalClosing {
  id             Int                 @id @default(autoincrement())
  fiscal_year_id Int
  status         FiscalClosingStatus @default(Open)

  closed_at DateTime? @db.Timestamptz(6)
  /// Plain Int with no FK, exactly like `created_by` elsewhere — the DBML
  /// declares authorship that way throughout.
  closed_by Int?

  /// The `CLS-` journal this close produced, and the `OPB-` snapshot it wrote
  /// for the following year. Both are other modules' documents, so they are
  /// held as ids rather than as relations (CLAUDE.md §3): a relation would put
  /// a back-reference on `acc_journal`, which is a book and is meant to be
  /// liftable. Null until a close actually happens — nothing writes either yet.
  closing_journal_id Int?
  opening_balance_id Int?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  fiscal_year AccFiscalYear @relation(fields: [fiscal_year_id], references: [id])

  @@unique([fiscal_year_id])
  @@map("acc_fiscal_closing")
}

/// The balances at the start of one fiscal year — a snapshot, not a
/// running store.
///
/// It exists so that a report does not have to scan from the first historical
/// transaction to work out where an account stood, and so that a closed year
/// hands the next one its position in a form somebody can read. It is
/// **immutable**: written once, by a close or by a developer injecting go-live
/// figures, and never edited afterwards. There is no create form and no edit
/// path in the application.
///
/// Base currency only, deliberately: the journal, the General Ledger and the
/// Trial Balance are all base-currency statements, and a snapshot of them is
/// the same measure. That is why there is no `currency_id` here.
///
/// `source_fiscal_year_id` is what tells a generated snapshot from an injected
/// one. A close writes the year it closed; a developer seeding go-live
/// balances leaves it null, because nothing produced them.
model AccOpeningBalance {
  id           Int      @id @default(autoincrement())
  opening_no   String   @unique
  /// The day the figures speak for — the first day of the year being opened.
  posting_date DateTime @db.Date

  /// The year this snapshot opens.
  fiscal_year_id        Int
  /// The year whose close produced it, or null for injected go-live balances.
  source_fiscal_year_id Int?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  fiscal_year        AccFiscalYear  @relation("OpeningBalanceYear", fields: [fiscal_year_id], references: [id])
  source_fiscal_year AccFiscalYear? @relation("OpeningBalanceSource", fields: [source_fiscal_year_id], references: [id])

  lines AccOpeningBalanceLine[]

  /// One snapshot per year. A second would be a second answer to "where did
  /// the company stand on 1 January", and the document is
  /// immutable, so there is no legitimate way to reach two.
  @@unique([fiscal_year_id])
  @@map("acc_opening_balance")
}

/// One balance, at the grain the journal itself keeps: `(account, partner?)`.
///
/// A Hutang account owed to three branches produces three lines; an account
/// naming no Partner produces one line with `partner_id = null`. There is
/// deliberately **no** parent row holding the account's total — that figure is
/// the sum of its children, and an immutable snapshot has no rebuild function
/// to prove a stored duplicate still agrees with what it duplicates.
///
/// The grain is derived from the posted journal lines as they actually are,
/// never from `acc_account.require_partner`: reading the flag would drop a
/// partner-bearing balance sitting on an unflagged account, and would invent a
/// null-partner line for an account that has none.
///
/// Exactly one of `debit_amount` / `kredit_amount` carries the value, and the
/// document's two sides sum equal — after the P&L has been closed out, what
/// remains is a balance sheet.
model AccOpeningBalanceLine {
  id          Int @id @default(autoincrement())
  opening_id  Int
  sequence_no Int

  account_id Int
  partner_id Int?

  /// Base currency, like every figure in the journal this is a snapshot of.
  debit_amount  Decimal @default(0) @db.Decimal(18, 2)
  kredit_amount Decimal @default(0) @db.Decimal(18, 2)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  opening AccOpeningBalance @relation(fields: [opening_id], references: [id])
  account AccAccount        @relation(fields: [account_id], references: [id])
  partner MPartner?         @relation(fields: [partner_id], references: [id])

  /// One line per pair. The index is created `NULLS NOT DISTINCT` in the
  /// migration's own SQL — Postgres otherwise treats two null-partner rows for
  /// one account as distinct, which is precisely the duplicate this is for.
  /// Prisma cannot express that, so the migration says it and this says why.
  @@unique([opening_id, account_id, partner_id])
  @@index([opening_id])
  @@map("acc_opening_balance_line")
}

// ---------------------------------------------------------------- audit

/// One trail for every table. Referenced loosely by entity key and row id
/// rather than by FK, since it spans every table.
/// A journal produced by a business posting is `Posted` the moment it exists —
/// it is the record of something that has already happened. A **manual**
/// journal is typed by a person, so it is saved `Draft` first and reaches
/// `Posted` through the same posting engine; `Cancelled` retires a draft that
/// should not exist, since nothing in this application is deleted.
///
/// Only a `Posted` journal is accounting: the General Ledger, the Trial Balance
/// and every balance reader filter on it. See CLAUDE.md §12.
enum JournalStatus {
  Draft
  Posted
  Cancelled
}

/// The accounting journal. A `Posted` journal is append-only and immutable:
/// once posted, a journal and its lines are never updated and never deleted. A
/// correction is a new journal, exactly as a corrected business transaction is
/// a new document.
///
/// A manual journal is editable while it is still `Draft`, and a draft is not
/// accounting — it moves nothing and no report can see it.
///
/// Only the General Ledger derives from these lines. The operational books —
/// the Cash Bank Book and the subject ledgers — are independent historical
/// stores written alongside the journal, never from it (§2.5).
model AccJournal {
  id                 Int           @id @default(autoincrement())
  journal_no         String        @unique
  /// The day the journal belongs to in the books — its document's date, which
  /// may be earlier than today (a backdated document) and never later. A
  /// manual draft carries the date it is meant for; every reader filters
  /// `status: "Posted"`, so a draft's date reaches no report. When the journal
  /// was actually written is `created_at`. Null only on a draft saved before
  /// drafts carried a date.
  posting_date       DateTime?     @db.Date
  /// What produced this journal, for traceability back to the document.
  source_doc_type_id Int?
  source_doc_id      Int?
  description        String
  status             JournalStatus @default(Posted)
  /// Typed by a person rather than produced by a document's posting. It is the
  /// only kind of journal that is ever a draft, the only one that is editable,
  /// and the only one whose accounts are narrowed by the control-account rule.
  is_manual          Boolean       @default(false)

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  source_doc_type SysDocType?      @relation(fields: [source_doc_type_id], references: [id])
  lines           AccJournalLine[]
  cash_bank_txs   FinCashBankTx[]

  @@index([posting_date])
  @@index([source_doc_type_id, source_doc_id])
  @@map("acc_journal")
}

/// One accounting entry. Exactly one of `debit_amount` / `kredit_amount`
/// carries the value and the other is zero; the two sides of a journal must
/// sum equal, which `postJournal` refuses to write without.
model AccJournalLine {
  id          Int @id @default(autoincrement())
  journal_id  Int
  sequence_no Int

  account_id Int
  partner_id Int?

  /// The line's own currency, which need not be the base one — and need not
  /// match the other lines of the same journal. A foreign document paid from a
  /// base-currency resource produces one journal holding both.
  currency_id   Int
  /// What `trx_amount` was worth: this line's currency to the base currency.
  /// `1` means the money is already base currency, and nothing else.
  exchange_rate Decimal @default(1) @db.Decimal(18, 6)

  /// **Base currency.** This is what the journal balances in, what the General
  /// Ledger reports, and what the Trial Balance totals — concept doc §11.2 and
  /// §16. Exactly one side carries value.
  debit_amount  Decimal @default(0) @db.Decimal(18, 2)
  kredit_amount Decimal @default(0) @db.Decimal(18, 2)
  /// The transaction-currency value of the entry, whichever side it fell on.
  /// Carried so a rupiah figure can be read back to the three hundred dollars
  /// that produced it; nothing is ever totalled in it.
  trx_amount    Decimal @db.Decimal(18, 2)

  description String

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  journal  AccJournal  @relation(fields: [journal_id], references: [id])
  account  AccAccount  @relation(fields: [account_id], references: [id])
  partner  MPartner?   @relation(fields: [partner_id], references: [id])
  currency RefCurrency @relation(fields: [currency_id], references: [id])

  @@index([journal_id])
  @@index([account_id])
  @@map("acc_journal_line")
}

/// Every create, update and lifecycle transition in the application appends one
/// row here, and nothing ever updates or deletes one.
///
/// `action` is the coarse verb and `event` is the specific thing that
/// happened. The verb alone cannot answer what a history is opened for:
/// submit, approve, reject, post and confirm are all writes, so all of them
/// read as UPDATE. `event` carries the transition key the owning module's
/// workflow table already declares — "submit", "approve", "post" — and the
/// Indonesian label is read back from that table rather than stored here, so a
/// new lifecycle step is a row in a workflow table and not a migration.
///
/// It is nullable because rows written before the column existed genuinely do
/// not know which transition they were, and "Diubah" is the true answer for
/// them. See `lib/siba/audit-events.ts`.
model AuditLog {
  id         Int         @id @default(autoincrement())
  entity_key String
  row_id     Int
  action     AuditAction
  event      String?
  at         DateTime    @default(now()) @db.Timestamptz(6)
  by         Int

  @@index([entity_key, row_id])
  @@map("audit_log")
}

// ================================================================ sales
//
// Sales documents (Claude-ERP.md §3.2). Rupiah only for now (P13), so no
// currency column: every amount here is IDR.

/// A Sales Order — SO Barang (P49). Posts nothing: no journal, no book, no tax
/// document. Its totals are stored as the tax module computed them at the last
/// save, so a list can show them and a confirmed order keeps the figures it was
/// confirmed with.
model SalOrder {
  id         Int              @id @default(autoincrement())
  /// `SO/YYYY/MM/NNNN`, in the series of the order's own month.
  order_no   String           @unique
  order_date DateTime         @db.Date
  status     SalesOrderStatus @default(Draft)

  customer_id               Int
  /// One of the customer's addresses, by id (P53).
  address_id                Int
  term_id                   Int
  /// Whether the order carries PPN at all, decided once for the order (P52).
  is_taxable                Boolean   @default(true)
  price_mode                PriceMode
  /// The PPN rate and DPP Nilai Lain factor the order was computed with,
  /// snapshotted from the System Default at each save while Draft and frozen
  /// at Ajukan (P60, P63). Null when the order is not Kena PPN.
  ppn_rate                  Decimal?  @db.Decimal(9, 4)
  ppn_dpp_other_numerator   Int?
  ppn_dpp_other_denominator Int?

  po_no       String?
  po_date     DateTime? @db.Date
  /// Free text (P43, P52).
  salesperson String?
  note        String?

  // ---- totals, from `lib/erp/sales-tax.ts`, whole rupiah.
  gross_amount     Decimal @default(0) @db.Decimal(18, 2)
  discount_amount  Decimal @default(0) @db.Decimal(18, 2)
  dpp_amount       Decimal @default(0) @db.Decimal(18, 2)
  /// DPP Nilai Lain, the sum of the lines' (P60).
  dpp_other_amount Decimal @default(0) @db.Decimal(18, 2)
  ppn_amount       Decimal @default(0) @db.Decimal(18, 2)
  total_amount     Decimal @default(0) @db.Decimal(18, 2)

  /// Why the order was cancelled, rejected or closed by hand — the one final
  /// step it took (P63). Null for an order closed because it was fulfilled.
  status_reason  String?
  /// The order this one was copied from with Salin, if any.
  copied_from_id Int?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  customer    MPartner        @relation(fields: [customer_id], references: [id])
  address     MPartnerAddress @relation(fields: [address_id], references: [id])
  term        RefPaymentTerm  @relation(fields: [term_id], references: [id])
  copied_from SalOrder?       @relation("SalesOrderCopy", fields: [copied_from_id], references: [id])
  copies      SalOrder[]      @relation("SalesOrderCopy")
  lines       SalOrderLine[]
  advances    SalAdvance[]

  @@index([customer_id])
  @@index([status, order_date])
  @@map("sal_order")
}

/// One line of a Sales Order: a Barang, in one of its units, at a typed price.
model SalOrderLine {
  id       Int @id @default(autoincrement())
  order_id Int
  line_no  Int

  item_id    Int
  uom_id     Int
  /// Base units in one `uom_id`, copied from the item at save — 1 for the
  /// base unit — so a later change to the item's conversions does not change
  /// what this order asked for.
  uom_factor Decimal @db.Decimal(18, 4)
  qty        Decimal @db.Decimal(18, 4)
  /// Per `uom_id`, typed in the order's price mode.
  price      Decimal @db.Decimal(18, 2)

  discount_type    DiscountType?
  /// A percent (`Percent`) or an amount (`Amount`), as typed.
  discount_value   Decimal?      @db.Decimal(18, 4)
  discount_amount  Decimal       @default(0) @db.Decimal(18, 2)
  /// qty × price − discount, whole rupiah.
  amount           Decimal       @db.Decimal(18, 2)
  dpp_amount       Decimal       @db.Decimal(18, 2)
  /// DPP Nilai Lain of this line; PPN is computed per line from it (P60).
  dpp_other_amount Decimal       @default(0) @db.Decimal(18, 2)
  ppn_amount       Decimal       @db.Decimal(18, 2)

  /// The PPh the customer is expected to withhold on this line, or null (P52).
  withholding_tax_id Int?
  /// The rate at save, so an estimate does not move when the master does.
  withholding_rate   Decimal? @db.Decimal(9, 4)

  note String?

  order           SalOrder           @relation(fields: [order_id], references: [id])
  item            MItem              @relation(fields: [item_id], references: [id])
  uom             RefUom             @relation(fields: [uom_id], references: [id])
  withholding_tax RefWithholdingTax? @relation(fields: [withholding_tax_id], references: [id])

  @@unique([order_id, line_no])
  @@index([item_id])
  @@map("sal_order_line")
}

/// An AR advance bill — Uang Muka Penjualan (P54–P58). A bill, not a
/// transaction: it posts nothing at any step. It is the anchor the customer's
/// payment and, later, the invoice deduction name. Its money and its PPN are
/// recorded by Pembayaran on the day it arrives; how much of it is paid or used
/// is not stored here — that belongs to the open items (C22).
///
/// Always drawn from one confirmed Sales Order, whose customer, address, price
/// mode and Kena PPN it follows. Its figures are stored as the tax module
/// computed them at the last save.
model SalAdvance {
  id           Int           @id @default(autoincrement())
  /// `ARA/YYYY/MM/NNNN`, in the series of the bill's own month.
  advance_no   String        @unique
  advance_date DateTime      @db.Date
  due_date     DateTime      @db.Date
  status       AdvanceStatus @default(Draft)

  order_id     Int
  /// The order's customer, kept on the bill because the partner is what an
  /// advance is settled by (C22).
  customer_id  Int
  /// A Bank-type Cash & Bank in rupiah, printed on the bill as where to pay.
  cash_bank_id Int
  /// The one line the bill prints.
  description  String
  note         String?

  /// Copied from the order, which is locked once confirmed.
  price_mode                PriceMode
  is_taxable                Boolean
  /// The bill's own snapshot of the PPN rate and DPP Nilai Lain factor, taken
  /// at each save while Draft and frozen at Terbitkan (P60). Null when the
  /// order is not Kena PPN.
  ppn_rate                  Decimal?  @db.Decimal(9, 4)
  ppn_dpp_other_numerator   Int?
  ppn_dpp_other_denominator Int?

  /// As typed: a percent of the order's value, or a flat value (P55).
  amount_type  AdvanceAmountType
  amount_value Decimal           @db.Decimal(18, 4)

  // ---- figures, from `lib/erp/sales-tax.ts`, whole rupiah.
  /// The value drawn, in the order's price mode — what the room is spent in.
  amount           Decimal @db.Decimal(18, 2)
  dpp_amount       Decimal @db.Decimal(18, 2)
  /// DPP Nilai Lain by the snapshotted factor; zero when not Kena PPN.
  dpp_other_amount Decimal @db.Decimal(18, 2)
  ppn_amount       Decimal @db.Decimal(18, 2)
  /// What the bill asks for: DPP + PPN.
  total_amount     Decimal @db.Decimal(18, 2)

  cancel_reason String?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  order     SalOrder  @relation(fields: [order_id], references: [id])
  customer  MPartner  @relation(fields: [customer_id], references: [id])
  cash_bank MCashBank @relation(fields: [cash_bank_id], references: [id])

  @@index([order_id])
  @@index([customer_id])
  @@index([status, advance_date])
  @@map("sal_advance")
}

// ------------------------------------------------------ cash bank transaction
//
// Penerimaan and Pengeluaran Kas & Bank (Claude-ERP.md P66–P70): one document
// for every movement of money through a cash or bank resource, in one table
// for both directions. Its purpose — a key of the catalogue in
// `lib/erp/cash-bank-purposes.ts` — decides what it settles and how it posts.
// A Draft touches no book; posting writes the journal and the Cash Bank Book
// together.

enum CashBankTxStatus {
  Draft
  Posted
  Cancelled
}

model FinCashBankTx {
  id        Int              @id @default(autoincrement())
  /// `BKM/YYYY/MM/NNNN` for Penerimaan, `BKK/…` for Pengeluaran.
  tx_no     String           @unique
  direction FlowDirection
  /// A key of the purpose catalogue in code (P66), not a foreign key.
  purpose   String
  tx_date   DateTime         @db.Date
  status    CashBankTxStatus @default(Draft)

  partner_id   Int
  cash_bank_id Int
  /// The transaction number on the bank statement.
  bank_ref     String?
  note         String?

  /// What actually reached (or left) the resource — the Cash Bank Book amount.
  cash_amount    Decimal @db.Decimal(18, 2)
  /// The transfer fee the bank kept; the company absorbs it (P68).
  bank_charge    Decimal @default(0) @db.Decimal(18, 2)
  /// The lines' Dilunasi, summed.
  settled_amount Decimal @default(0) @db.Decimal(18, 2)
  /// The PPh the partner withheld, summed over lines and types.
  pph_amount     Decimal @default(0) @db.Decimal(18, 2)

  /// The journal posting wrote.
  journal_id    Int?
  cancel_reason String?

  created_by Int
  updated_by Int?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  partner   MPartner            @relation(fields: [partner_id], references: [id])
  cash_bank MCashBank           @relation(fields: [cash_bank_id], references: [id])
  journal   AccJournal?         @relation(fields: [journal_id], references: [id])
  lines     FinCashBankTxLine[]

  @@index([direction, status, tx_date])
  @@index([partner_id])
  @@map("fin_cash_bank_tx")
}

/// One document a transaction settles, named by the weak `(doc_type_id,
/// doc_id)` pair because it belongs to another module (§3.1). Each document
/// appears once per transaction.
model FinCashBankTxLine {
  id          Int @id @default(autoincrement())
  tx_id       Int
  line_no     Int
  doc_type_id Int
  doc_id      Int

  /// The part of the document this line clears: cash + its share of the
  /// bank charge + PPh withheld.
  settled_amount Decimal @db.Decimal(18, 2)
  /// The Potong PPh switch (P60): off, the partner paid without withholding.
  withhold       Boolean @default(true)
  /// The split of `settled_amount` an advance's faktur pajak will carry.
  dpp_part       Decimal @default(0) @db.Decimal(18, 2)
  ppn_part       Decimal @default(0) @db.Decimal(18, 2)
  pph_amount     Decimal @default(0) @db.Decimal(18, 2)

  created_by Int
  created_at DateTime @default(now()) @db.Timestamptz(6)

  tx       FinCashBankTx          @relation(fields: [tx_id], references: [id], onDelete: Cascade)
  doc_type SysDocType             @relation(fields: [doc_type_id], references: [id])
  whts     FinCashBankTxLineWht[]

  @@unique([tx_id, doc_type_id, doc_id])
  @@index([doc_type_id, doc_id])
  @@map("fin_cash_bank_tx_line")
}

/// The PPh withheld on one line, per Jenis PPh — the unit one Bukti Potong
/// will be made from (P69).
model FinCashBankTxLineWht {
  id                 Int     @id @default(autoincrement())
  line_id            Int
  withholding_tax_id Int
  rate               Decimal @db.Decimal(9, 4)
  base_amount        Decimal @db.Decimal(18, 2)
  amount             Decimal @db.Decimal(18, 2)

  line            FinCashBankTxLine @relation(fields: [line_id], references: [id], onDelete: Cascade)
  withholding_tax RefWithholdingTax @relation(fields: [withholding_tax_id], references: [id])

  @@unique([line_id, withholding_tax_id])
  @@map("fin_cash_bank_tx_line_wht")
}

// ---------------------------------------------------------------- AR items
//
// What a customer owes and has paid ahead, per document (Claude-ERP.md
// P71–P75). An AR item is the settlement unit: an Uang Muka is born when an
// advance is received, an Invoice when a Faktur Penjualan is posted. Its
// balance moves only through Buku Piutang, which is append-only. AP will have
// tables of its own.

enum ArItemType {
  Advance
  Invoice
}

/// Whether the item raises the customer's Piutang Usaha (Invoice) or lowers
/// it (Advance). Exposure = balance × direction.
enum ArDirection {
  Increase
  Decrease
}

/// What moved an AR item's balance. Refund, retur and DN/CN arrive when they
/// are built (P74).
enum ArEvent {
  Create
  Payment
  AdvanceUsed
}

model FinArItem {
  id          Int         @id @default(autoincrement())
  item_type   ArItemType
  direction   ArDirection
  partner_id  Int
  currency_id Int
  item_date   DateTime    @db.Date
  /// When an Invoice falls due, for Umur Piutang. None on an Uang Muka.
  due_date    DateTime?   @db.Date

  /// The document that created the item — the receipt for an Uang Muka, the
  /// Faktur for an Invoice — and its number as it read then.
  source_doc_type_id Int
  source_doc_id      Int
  source_no          String
  /// What it belongs to beside that: the advance bill an Uang Muka was paid
  /// against.
  ref_doc_type_id    Int?
  ref_doc_id         Int?
  ref_no             String?
  /// The Sales Order, by id — an invoice uses only its own order's advances
  /// (P73). A weak reference: the order belongs to another module.
  order_id           Int?
  order_no           String?

  /// What is still open, in the item's own currency: the sum of its Buku
  /// Piutang entries, updated in the same transaction as each (P72).
  current_balance Decimal @db.Decimal(18, 2)

  created_by Int
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  partner         MPartner      @relation(fields: [partner_id], references: [id])
  currency        RefCurrency   @relation(fields: [currency_id], references: [id])
  source_doc_type SysDocType    @relation("ArItemSource", fields: [source_doc_type_id], references: [id])
  ref_doc_type    SysDocType?   @relation("ArItemRef", fields: [ref_doc_type_id], references: [id])
  entries         FinArLedger[] @relation("ArItemEntries")
  counter_entries FinArLedger[] @relation("ArItemCounter")

  @@index([partner_id, item_type])
  @@index([order_id])
  @@index([source_doc_type_id, source_doc_id])
  @@index([ref_doc_type_id, ref_doc_id])
  @@map("fin_ar_item")
}

/// Buku Piutang — every change to an AR item's balance, append-only: an entry
/// is never edited or deleted (P72).
model FinArLedger {
  id            Int      @id @default(autoincrement())
  item_id       Int
  event         ArEvent
  entry_date    DateTime @db.Date
  /// Always positive; `movement` carries the sign on the item's balance.
  amount        Decimal  @db.Decimal(18, 2)
  movement      Decimal  @db.Decimal(18, 2)
  balance_after Decimal  @db.Decimal(18, 2)

  /// The document that caused the entry, and its number.
  doc_type_id     Int
  doc_id          Int
  doc_no          String
  /// An advance used by an invoice names the Invoice item that took it.
  counter_item_id Int?
  note            String?

  created_by Int
  created_at DateTime @default(now()) @db.Timestamptz(6)

  item         FinArItem  @relation("ArItemEntries", fields: [item_id], references: [id])
  counter_item FinArItem? @relation("ArItemCounter", fields: [counter_item_id], references: [id])
  doc_type     SysDocType @relation(fields: [doc_type_id], references: [id])

  @@index([item_id, entry_date])
  @@index([doc_type_id, doc_id])
  @@map("fin_ar_ledger")
}
