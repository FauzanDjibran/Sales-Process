{
  "name": "erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start -p 3110",
    "lint": "eslint",
    "db:seed": "node --env-file-if-exists=.env --conditions=react-server --import tsx prisma/seed.ts",
    "db:neon-migrate": "node scripts/with-remote.mjs npx prisma migrate deploy",
    "db:neon-seed": "node scripts/with-remote.mjs node --conditions=react-server --import tsx prisma/seed.ts",
    "db:tax-backfill": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/tax-backfill.ts",
    "db:neon-tax-backfill": "node scripts/with-remote.mjs node --conditions=react-server --import tsx scripts/tax-backfill.ts",
    "db:neon-reconcile": "node scripts/with-remote.mjs node --conditions=react-server --import tsx scripts/reconcile.ts",
    "db:truncate-transactions": "node --env-file-if-exists=.env --import tsx scripts/truncate-transactions.ts",
    "db:stock-inject": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/stock-inject.ts",
    "db:neon-stock-inject": "node scripts/with-remote.mjs node --conditions=react-server --import tsx scripts/stock-inject.ts",
    "db:reconcile": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/reconcile.ts",
    "db:seed-accounts": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/seed-accounts.ts",
    "db:neon-seed-accounts": "node scripts/with-remote.mjs node --conditions=react-server --import tsx scripts/seed-accounts.ts",
    "db:seed-showcase": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/seed-showcase.ts",
    "db:neon-seed-showcase": "node scripts/with-remote.mjs node --conditions=react-server --import tsx scripts/seed-showcase.ts",
    "db:seed-cash-bank-showcase": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/seed-cash-bank-showcase.ts",
    "db:neon-seed-cash-bank-showcase": "node scripts/with-remote.mjs node --conditions=react-server --import tsx scripts/seed-cash-bank-showcase.ts",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "db:fresh": "npm run db:reset && npm run db:seed-showcase",
    "db:neon-reset": "node scripts/with-remote.mjs --destructive npx prisma migrate reset --force",
    "test": "node --env-file-if-exists=.env --conditions=react-server --import tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true
  }
}
