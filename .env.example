# Copy to `.env` and fill in real values. `.env` is gitignored; this file is not.

# Local PostgreSQL. Change the password to whatever you set during install.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/erp?schema=public"

# --- Bootstrap administrator ------------------------------------------------
# Read by `npm run db:seed` to create the first account that can manage users.
# Everything else in the application is administered through that account.
#
# ERP_ADMIN_PASSWORD is REQUIRED when NODE_ENV=production; the seed refuses to
# run without it. In development it falls back to the weak shared password the
# seed prints, which must never reach a deployed environment.
ERP_ADMIN_EMAIL="admin@erp.app"
ERP_ADMIN_NAME="Administrator"
ERP_ADMIN_INITIALS="AD"
ERP_ADMIN_PASSWORD=""

# --- First-install identity -------------------------------------------------
# Read by `npm run db:seed` the first time it runs, and ignored afterwards.
#
# The base reporting currency, seeded so a fresh install can register a Cash &
# Bank resource immediately. Every other currency is added through the UI.
# The base currency LABEL is not configurable — it lives in src/lib/erp/currency.ts,
# because the books record what every movement was worth in it.
ERP_BASE_CURRENCY_NAME="Rupiah Indonesia"

# Sessions are stored in the database and the cookie carries only an opaque
# random token, so there is no signing secret to configure.
